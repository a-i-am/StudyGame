{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudyGameTaskManifest",
  "description": "StudyGame 단일 기능 단위 작업 명세서(Feature Spec) 검증용 정본 JSON 스키마",
  "type": "object",
  "required": [
    "taskId",
    "featureName",
    "coreLoopContext",
    "boundaryConstraints",
    "definitionOfDone"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "pattern": "^task-\\d{3}-[a-z0-9-]+$",
      "description": "작업 고유 식별자 (예: task-001-inventory-uitoolkit-refactor)"
    },
    "featureName": {
      "type": "string",
      "description": "구현 또는 리팩토링할 기능의 명칭"
    },
    "coreLoopContext": {
      "type": "object",
      "required": ["domain", "intent"],
      "properties": {
        "domain": {
          "type": "string",
          "enum": [
            "VirtualOS_2D",
            "ActionArena_3D",
            "DirectorTooling_Editor",
            "DataPipeline_SO",
            "Network_UWB"
          ],
          "description": "작업이 속하는 코어 도메인 영역"
        },
        "intent": {
          "type": "string",
          "description": "기획 의도 및 달성 목표 요약 (What & Why)"
        },
        "edgeCases": {
          "type": "array",
          "items": { "type": "string" },
          "description": "놓치기 쉬운 기획 엣지 케이스 및 예외 처리 규칙"
        }
      }
    },
    "stateAndDataSpec": {
      "type": "object",
      "properties": {
        "targetFSM": {
          "type": "string",
          "description": "관련 상태 머신 및 전이 규칙 (예: SlotVisualState: Empty -> Occupied)"
        },
        "dataStructures": {
          "type": "array",
          "items": { "type": "string" },
          "description": "참조하거나 생성할 ScriptableObject 또는 DTO 구조체"
        },
        "uiBindings": {
          "type": "array",
          "items": { "type": "string" },
          "description": "바인딩할 UXML/USS 요소 이름 또는 UGUI 컴포넌트"
        }
      }
    },
    "boundaryConstraints": {
      "type": "object",
      "required": ["allowedPaths", "prohibitedPaths"],
      "properties": {
        "allowedPaths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "수정 및 생성이 명시적으로 허용된 파일/폴더 경로 목록"
        },
        "prohibitedPaths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "수정이 절대 금지된 코어 경로 목록"
        },
        "forbiddenPatterns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "코드 내 사용이 엄격히 금지된 안티 패턴 (예: Update 내 Q<T>() 호출, new 키워드)"
        }
      }
    },
    "definitionOfDone": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "작업 완료 판정을 위해 통과해야 하는 정량적 검증 체크리스트"
    }
  },
  "additionalProperties": false
}
