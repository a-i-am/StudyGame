/* ---------- Root & Variables ---------- */
.vn-root {
    --punk-magenta: #f41b75;
    --punk-magenta-dark: #8c093d;
    --punk-teal: #1f696e;
    --punk-teal-dark: #0e383b;
    --punk-amber: #f59e0b;
    --punk-cyan: #06b6d4;
    --punk-emerald: #10b981;
    --bg-dark: #050407;
    --frame-bg: #131118;

    flex-grow: 1;
    background-color: var(--bg-dark);
    -unity-font-definition: url("../Fonts/ZenOldMincho-Bold SDF.asset"); /* 폰트 에셋 경로 필요 */
    color: #f1f1f5;
    overflow: hidden;
    justify-content: space-between;
}

/* ---------- Overlays ---------- */
.vn-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.vn-scanlines {
    background-color: rgba(255, 255, 255, 0.02);
    /* UI Toolkit은 repeating-linear-gradient가 없으므로 반투명 텍스처나 C# 처리 권장 */
    opacity: 0.6;
}

.vn-vignette {
    background-color: rgba(244, 27, 117, 0.4);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.35s;
}

.vn-vignette--hidden { opacity: 0; }

/* ---------- Background Scene ---------- */
.vn-bg-container {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    flex-direction: column;
    justify-content: flex-end;
}

.vn-bg-teal {
    height: 62%;
    border-bottom-width: 4px;
    border-bottom-color: #000000;
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
}

.vn-teal-accent-left { position: absolute; left: -40px; width: 120px; height: 100%; background-color: #133c3f; rotate: -12deg; opacity: 0.8; border-right-width: 4px; border-right-color: #000; }
.vn-teal-accent-right { position: absolute; right: 0; width: 33%; height: 100%; background-color: #174649; opacity: 0.7; border-left-width: 4px; border-left-color: #000; }

.vn-character-silhouette {
    width: 320px;
    height: 92%;
    background-color: rgba(0,0,0,0.5); /* 실제 캐릭터 스프라이트 들어갈 자리 */
    border-top-left-radius: 100px;
    border-top-right-radius: 100px;
}

.vn-bg-magenta {
    height: 38%;
    border-top-width: 4px;
    border-top-color: #000000;
    overflow: hidden;
}

.vn-magenta-slash-1 { position: absolute; right: -40px; top: -40px; width: 250px; height: 250px; background-color: #000; rotate: 12deg; opacity: 0.85; }
.vn-magenta-slash-2 { position: absolute; left: 40px; bottom: -30px; width: 320px; height: 120px; background-color: #000; rotate: -6deg; opacity: 0.75; }

/* ---------- Badges & Primitives ---------- */
.vn-diamond { rotate: 45deg; }

.vn-header-left { position: absolute; top: 24px; left: 24px; flex-direction: row; align-items: center; }
.vn-projection-badge {
    width: 56px; height: 56px;
    background-color: #3d3a44;
    border-width: 2px; border-color: #16141a;
    align-items: center; justify-content: center;
    transition-property: scale, background-color;
    transition-duration: 0.3s;
}
.vn-projection-badge:hover { scale: 1.1 1.1; background-color: var(--punk-magenta); }

.vn-diamond--badge { align-items: center; justify-content: center; }
.vn-badge-text { font-size: 28px; -unity-font-style: bold; color: #121115; rotate: -45deg; margin: 0; padding: 0; }
.vn-projection-badge:hover .vn-badge-text { color: #FFF; }

.vn-mode-indicator { background-color: rgba(0,0,0,0.85); border-left-width: 2px; border-left-color: var(--punk-magenta); padding: 4px 12px; margin-left: 12px; }
.vn-mode-title { font-size: 11px; -unity-font-style: bold; color: var(--punk-magenta); margin: 0; }
.vn-mode-sub { font-size: 10px; color: #a1a1aa; margin: 0; }

/* ---------- Navigation ---------- */
.vn-header-right { position: absolute; top: 24px; right: 24px; flex-direction: row; }
.vn-nav-btn {
    background-color: rgba(0,0,0,0.8);
    border-width: 1px; border-color: #3f3f46;
    color: #d4d4d8; font-size: 11px;
    padding: 6px 12px; margin-left: 8px;
    border-radius: 4px;
    transition-property: border-color, background-color, color, scale;
    transition-duration: 0.2s;
}
.vn-nav-btn:hover { background-color: var(--punk-magenta); border-color: var(--punk-magenta); color: #FFF; }
.vn-nav-btn:active { scale: 0.95 0.95; }

/* ---------- Dialogue Area ---------- */
.vn-click-zone { flex-grow: 1; justify-content: flex-end; padding: 24px 32px; }

.vn-nameplate-wrapper { flex-direction: row; padding-left: 40px; margin-bottom: -12px; z-index: 30; }
.vn-nameplate {
    flex-direction: row; align-items: center;
    background-color: #0d0912;
    border-width: 2px; border-color: #b8145c;
    border-radius: 4px;
    padding: 6px 16px;
}
.vn-name-text { font-size: 20px; -unity-font-style: bold; color: #f3f0f7; letter-spacing: 2px; margin: 0; padding: 0; }

.vn-gems-container { flex-direction: row; margin-left: 12px; }
.vn-gem { width: 16px; height: 16px; margin-left: 6px; border-width: 1px; transition-property: scale, opacity; transition-duration: 0.2s; }
.vn-gem--amber { background-color: var(--punk-amber); border-color: #fef08a; }
.vn-gem--cyan { background-color: var(--punk-cyan); border-color: #a5f3fc; }
.vn-gem--emerald { background-color: var(--punk-emerald); border-color: #a7f3d0; }

.vn-dialogue-frame {
    background-color: rgba(14, 12, 18, 0.95);
    border-width: 2px; border-color: #a3154f;
    border-radius: 16px;
    min-height: 165px;
    flex-direction: row; align-items: center;
    padding: 28px 48px;
    overflow: hidden;
}

.vn-decor-glass { position: absolute; top: 0; bottom: 0; width: 80px; background-color: rgba(244, 27, 117, 0.1); }
.vn-decor-glass--left { left: 0; border-right-width: 2px; border-right-color: rgba(244, 27, 117, 0.3); }
.vn-decor-glass--right { right: 0; border-left-width: 2px; border-left-color: rgba(244, 27, 117, 0.3); }

.vn-dialogue-content { flex-grow: 1; padding: 0 16px; }
.vn-dialogue-text {
    font-size: 21px;
    color: #f2edf4;
    white-space: normal;
    -unity-paragraph-spacing: 24px;
    margin: 0; padding: 0;
}

/* Sigil */
.vn-sigil-container { position: absolute; right: 36px; bottom: 16px; align-items: center; justify-content: center; }
.vn-sigil-outer { width: 32px; height: 32px; border-width: 4px; border-color: var(--punk-magenta); background-color: rgba(64, 7, 30, 0.6); align-items: center; justify-content: center; }
.vn-sigil-inner { width: 12px; height: 12px; border-radius: 99px; background-color: #e11d48; border-width: 2px; border-color: #fef08a; }

/* ---------- Modals & Toasts ---------- */
.vn-modal {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0,0,0,0.9);
    padding: 40px;
    transition-property: opacity; transition-duration: 0.3s;
}
.vn-modal--hidden { opacity: 0; display: none; }
.vn-modal-header { flex-direction: row; justify-content: space-between; border-bottom-width: 2px; border-bottom-color: var(--punk-magenta); padding-bottom: 16px; margin-bottom: 16px; }
.vn-modal-title { font-size: 20px; -unity-font-style: bold; color: #FFF; margin: 0; }
.vn-modal-scroll { flex-grow: 1; }

.vn-log-item { background-color: rgba(24, 24, 27, 0.8); border-left-width: 4px; border-left-color: var(--punk-magenta); padding: 12px; margin-bottom: 16px; border-radius: 4px; }
.vn-log-speaker { font-size: 12px; -unity-font-style: bold; color: var(--punk-magenta); margin-bottom: 4px; }
.vn-log-text { font-size: 14px; color: #e4e4e7; white-space: normal; }

.vn-toast {
    position: absolute; top: 80px; align-self: center;
    background-color: #16121d; border-width: 2px; border-color: var(--punk-magenta);
    border-radius: 99px; padding: 8px 20px;
    flex-direction: row; align-items: center;
    transition-property: opacity, translate; transition-duration: 0.3s;
}
.vn-toast--hidden { opacity: 0; translate: 0 -10px; }
.vn-toast-dot { width: 8px; height: 8px; border-radius: 99px; background-color: var(--punk-magenta); margin-right: 8px; }
.vn-toast-text { font-size: 14px; color: #FFF; margin: 0; }