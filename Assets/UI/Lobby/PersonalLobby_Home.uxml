<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="PersonalLobby_Home.uss" />
    <ui:VisualElement name="personal-lobby-root" class="lobby-root">
        <ui:VisualElement name="horizon-viewport" class="horizon-viewport">
            <ui:VisualElement class="horizon-sky" />
            <ui:VisualElement class="horizon-line" />
            <ui:VisualElement class="horizon-mirror-floor">
                <ui:VisualElement class="floor-ambient-glow" />
            </ui:VisualElement>
            <ui:VisualElement class="character-plane">
                <ui:VisualElement class="char-unit char-player">
                    <ui:VisualElement class="char-sprite player-sprite">
                        <ui:Label text="관찰자 (주인공)" class="char-nametag" />
                    </ui:VisualElement>
                    <ui:VisualElement class="char-reflection player-reflection" />
                </ui:VisualElement>
                <ui:VisualElement class="char-unit char-npc">
                    <ui:VisualElement class="char-sprite npc-sprite">
                        <ui:Label text="한세아 (동급생)" class="char-nametag" />
                    </ui:VisualElement>
                    <ui:VisualElement class="char-reflection npc-reflection" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="foreground-ui-layer" class="foreground-ui-layer">
            <ui:VisualElement name="top-status-bar" class="status-bar">
                <ui:VisualElement class="status-left">
                    <ui:Label text="12:45" class="status-time" />
                    <ui:Label text="• RAMI HIGH OS" class="status-os-name" />
                </ui:VisualElement>
                <ui:VisualElement class="status-right">
                    <ui:VisualElement class="sync-badge">
                        <ui:VisualElement class="sync-dot" />
                        <ui:Label text="SYNC 68%" class="sync-text" />
                    </ui:VisualElement>
                    <ui:Label text="LTE" class="status-net" />
                    <ui:VisualElement class="status-battery">
                        <ui:VisualElement class="status-battery-bar" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="content-container">
                <ui:VisualElement name="anomaly-widget" class="anomaly-widget">
                    <ui:VisualElement class="widget-header">
                        <ui:Label text="결계 이상 징후 감지" class="widget-title" />
                        <ui:Label text="위험도 2단계" class="widget-badge" />
                    </ui:VisualElement>
                    <ui:Label text="본관 3층 복도에 기이 공간 수렴 현상 발생. 교과 태그: [수학-도형의성질]" class="widget-desc" />
                </ui:VisualElement>
                <ui:VisualElement name="app-grid" class="app-grid">
                    <ui:Button name="btn-archive" class="app-btn">
                        <ui:VisualElement class="app-icon icon-archive" />
                        <ui:Label text="교과 아카이브" class="app-name" />
                    </ui:Button>
                    <ui:Button name="btn-sns" class="app-btn">
                        <ui:VisualElement class="app-icon icon-sns" />
                        <ui:Label text="가상 SNS" class="app-name" />
                    </ui:Button>
                    <ui:Button name="btn-deck" class="app-btn">
                        <ui:VisualElement class="app-icon icon-deck" />
                        <ui:Label text="스킬 덱" class="app-name" />
                    </ui:Button>
                    <ui:Button name="btn-settings" class="app-btn">
                        <ui:VisualElement class="app-icon icon-settings" />
                        <ui:Label text="환경 설정" class="app-name" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="dive-cta" class="dive-cta-container">
                    <ui:Button name="btn-dive" class="dive-btn">
                        <ui:VisualElement class="dive-btn-glow" />
                        <ui:Label text="▶ 3D 결계 다이브 (출격)" class="dive-btn-text" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="quick-dock" class="quick-dock">
                <ui:Button name="btn-sos" text="SOS 구원 퀴즈" class="dock-btn dock-btn-highlight" />
                <ui:Button name="btn-memo" text="관찰 메모" class="dock-btn" />
                <ui:Button name="btn-sync" text="동기화 정비" class="dock-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
