.lobby-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    background-color: #3B5369;
}

.horizon-viewport {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.horizon-sky {
    height: 52%;
    background-color: #6C8BA4;
}

.horizon-line {
    height: 1px;
    background-color: #D6E8F6;
}

.horizon-mirror-floor {
    height: 48%;
    background-color: #55728A;
    position: relative;
}

.floor-ambient-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 60px;
    background-color: rgba(220, 240, 255, 0.25);
}

.character-plane {
    position: absolute;
    top: 40%;
    left: 0;
    right: 0;
    height: 180px;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    padding-left: 24px;
    padding-right: 24px;
}

.char-unit {
    align-items: center;
    width: 90px;
}

.char-sprite {
    width: 64px;
    height: 80px;
    background-color: #E2E8F0;
    border-top-left-radius: 32px;
    border-top-right-radius: 32px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    align-items: center;
    justify-content: flex-start;
    padding-top: 6px;
    border-left-width: 1.5px;
    border-right-width: 1.5px;
    border-top-width: 1.5px;
    border-bottom-width: 1.5px;
    border-left-color: #FFFFFF;
    border-right-color: #FFFFFF;
    border-top-color: #FFFFFF;
    border-bottom-color: #CBD5E1;
}

.player-sprite {
    background-color: #334155;
    border-left-color: #94A3B8;
    border-right-color: #94A3B8;
    border-top-color: #CBD5E1;
    border-bottom-color: #1E293B;
}

.npc-sprite {
    background-color: #F472B6;
    border-left-color: #FBCFE8;
    border-right-color: #FBCFE8;
    border-top-color: #FFFFFF;
    border-bottom-color: #DB2777;
}

.char-nametag {
    font-size: 9px;
    color: #FFFFFF;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.45);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 1px;
    padding-bottom: 1px;
}

.char-reflection {
    width: 58px;
    height: 70px;
    opacity: 0.35;
    scale: 1 -0.8;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 28px;
    border-bottom-right-radius: 28px;
    margin-top: 2px;
}

.player-reflection {
    background-color: #1E293B;
}

.npc-reflection {
    background-color: #EC4899;
}

.foreground-ui-layer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    justify-content: space-between;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 16px;
}

.status-bar {
    height: 32px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(15, 23, 42, 0.35);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-left: 12px;
    padding-right: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.2);
    border-right-color: rgba(255, 255, 255, 0.2);
    border-top-color: rgba(255, 255, 255, 0.4);
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.status-left {
    flex-direction: row;
    align-items: center;
}

.status-time {
    color: #FFFFFF;
    font-size: 11px;
    -unity-font-style: bold;
}

.status-os-name {
    color: #94A3B8;
    font-size: 10px;
    margin-left: 6px;
}

.status-right {
    flex-direction: row;
    align-items: center;
}

.sync-badge {
    flex-direction: row;
    align-items: center;
    background-color: rgba(56, 189, 248, 0.25);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-right: 8px;
}

.sync-dot {
    width: 6px;
    height: 6px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: #38BDF8;
    margin-right: 4px;
}

.sync-text {
    font-size: 9px;
    color: #E0F2FE;
    -unity-font-style: bold;
}

.status-net {
    font-size: 9px;
    color: #CBD5E1;
    margin-right: 6px;
}

.status-battery {
    width: 16px;
    height: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #FFFFFF;
    border-right-color: #FFFFFF;
    border-top-color: #FFFFFF;
    border-bottom-color: #FFFFFF;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    padding-left: 1px;
    padding-right: 1px;
    padding-top: 1px;
    padding-bottom: 1px;
}

.status-battery-bar {
    width: 75%;
    height: 100%;
    background-color: #4ADE80;
}

.content-container {
    justify-content: flex-end;
    margin-bottom: 8px;
}

.anomaly-widget {
    background-color: rgba(15, 23, 42, 0.55);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(255, 255, 255, 0.15);
    border-top-color: rgba(255, 255, 255, 0.35);
    border-bottom-color: rgba(0, 0, 0, 0.3);
    margin-bottom: 10px;
}

.widget-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.widget-title {
    font-size: 11px;
    color: #F8FAFC;
    -unity-font-style: bold;
}

.widget-badge {
    font-size: 9px;
    color: #F43F5E;
    background-color: rgba(244, 63, 94, 0.2);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 1px;
    padding-bottom: 1px;
}

.widget-desc {
    font-size: 10px;
    color: #CBD5E1;
    white-space: normal;
}

.app-grid {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 10px;
}

.app-btn {
    width: 22%;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.2);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.3);
    border-right-color: rgba(255, 255, 255, 0.3);
    border-top-color: rgba(255, 255, 255, 0.6);
    border-bottom-color: rgba(0, 0, 0, 0.2);
}

.app-btn:hover {
    background-color: rgba(255, 255, 255, 0.35);
    scale: 1.04 1.04;
}

.app-btn:active {
    scale: 0.96 0.96;
}

.app-icon {
    width: 32px;
    height: 32px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    margin-bottom: 4px;
}

.icon-archive {
    background-color: #38BDF8;
}

.icon-sns {
    background-color: #EC4899;
}

.icon-deck {
    background-color: #10B981;
}

.icon-settings {
    background-color: #64748B;
}

.app-name {
    font-size: 9px;
    color: #FFFFFF;
    -unity-font-style: bold;
}

.dive-cta-container {
    width: 100%;
}

.dive-btn {
    height: 44px;
    background-color: #0284C7;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #38BDF8;
    border-right-color: #38BDF8;
    border-top-color: #7DD3FC;
    border-bottom-color: #0369A1;
    justify-content: center;
    align-items: center;
}

.dive-btn:hover {
    background-color: #0369A1;
    scale: 1.02 1.02;
}

.dive-btn:active {
    scale: 0.98 0.98;
}

.dive-btn-text {
    font-size: 13px;
    color: #FFFFFF;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.quick-dock {
    height: 36px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(15, 23, 42, 0.4);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-left: 8px;
    padding-right: 8px;
}

.dock-btn {
    height: 26px;
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    font-size: 10px;
    color: #CBD5E1;
    padding-left: 8px;
    padding-right: 8px;
}

.dock-btn:hover {
    color: #FFFFFF;
}

.dock-btn-highlight {
    color: #38BDF8;
    -unity-font-style: bold;
}
