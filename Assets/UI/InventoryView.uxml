<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd">

  <ui:Style src="Styles/PremiumTheme.uss" />

  <!-- Full Screen Container -->
  <ui:VisualElement name="InventoryRoot" class="glass-panel" style="flex-grow: 1; margin: 40px; padding: 20px; flex-direction: row; opacity: 0; transition-property: opacity, scale; transition-duration: 0.3s; scale: 0.95;">
    
    <!-- Left Panel: Item Grid -->
    <ui:VisualElement name="LeftPanel" style="flex-grow: 1; flex-basis: 60%; margin-right: 20px; flex-direction: column;">
      
      <!-- Header -->
      <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 15px; border-bottom-width: 1px; border-color: rgba(255,255,255,0.1); padding-bottom: 10px;">
        <ui:Label text="인벤토리 (Inventory)" class="text-title" />
        
        <!-- Filters -->
        <ui:VisualElement style="flex-direction: row;">
          <ui:Button name="BtnFilterAll" text="All" class="premium-btn" style="margin-right: 5px; padding: 5px 15px;" />
          <ui:Button name="BtnFilterLogic" text="Logic" class="premium-btn" style="margin-right: 5px; padding: 5px 15px;" />
          <ui:Button name="BtnFilterEmotion" text="Emotion" class="premium-btn" style="padding: 5px 15px;" />
        </ui:VisualElement>
      </ui:VisualElement>

      <!-- Scrollable Grid -->
      <ui:ScrollView name="ItemGridScroll" style="flex-grow: 1;">
        <!-- The item slots will be dynamically added here by C# script -->
        <ui:VisualElement name="ItemGridContainer" style="flex-direction: row; flex-wrap: wrap; justify-content: flex-start; align-content: flex-start;" />
      </ui:ScrollView>

      <!-- Footer / Close Button -->
      <ui:VisualElement style="margin-top: 15px; align-items: flex-start;">
        <ui:Label text="[I] 창 닫기" class="text-muted" style="margin-bottom: 5px;" />
        <ui:Button name="BtnClose" text="닫기 (Close)" class="premium-btn" />
      </ui:VisualElement>
      
    </ui:VisualElement>


    <!-- Right Panel: Detail View -->
    <ui:VisualElement name="RightPanel" class="panel-container" style="flex-grow: 1; flex-basis: 40%; padding: 25px; flex-direction: column;">
      
      <!-- Empty State -->
      <ui:VisualElement name="EmptyDetailView" style="flex-grow: 1; align-items: center; justify-content: center; display: flex;">
        <ui:Label text="아이템을 선택하면 상세 정보가 표시됩니다." class="text-muted" />
      </ui:VisualElement>

      <!-- Active State (Hidden by default) -->
      <ui:VisualElement name="ActiveDetailView" style="flex-grow: 1; display: none; flex-direction: column;">
        
        <!-- Big Icon Placeholder -->
        <ui:VisualElement style="align-items: center; justify-content: center; height: 160px; margin-bottom: 20px;">
          <ui:VisualElement name="DetailIcon" class="border-cyan" style="width: 120px; height: 120px; border-radius: 60px; background-color: rgba(255,255,255,0.05); border-width: 2px; transition-property: scale; transition-duration: 0.3s; transition-timing-function: ease-out-back;" />
        </ui:VisualElement>

        <ui:Label name="DetailTitle" text="도영의 가설" class="text-title" style="margin-bottom: 5px; text-align: center; font-size: 28px;" />
        <ui:Label name="DetailCategory" text="[주어] (Subject)" class="text-subtitle" style="margin-bottom: 15px; text-align: center;" />
        
        <ui:VisualElement name="DetailTags" style="flex-direction: row; justify-content: center; flex-wrap: wrap; margin-bottom: 20px;">
          <!-- Tags injected here -->
        </ui:VisualElement>

        <!-- Divider -->
        <ui:VisualElement class="bg-subtle-divider" style="height: 1px; margin-bottom: 20px;" />


        <!-- Lore Text -->
        <ui:ScrollView style="flex-grow: 1;">
          <ui:Label name="DetailLoreText" text="이것은 매우 중요한 단서입니다. 도영이 어제 밤 라디오 부스에 두고 간 것으로 추정됩니다..." class="text-body" style="font-size: 15px; line-height: 24px; padding: 10px;" />
        </ui:ScrollView>

      </ui:VisualElement>
    </ui:VisualElement>

  </ui:VisualElement>
</ui:UXML>
