<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:ext="UnityUIToolkit.Extensions" editor-extension-mode="False">
    <ui:Style src="project://database/Packages/com.sinanata.designsystem/Resources/UI/Styles/DesignSystem/DesignTokens.uss" />
    <ui:Style src="project://database/Packages/com.sinanata.designsystem/Resources/UI/Styles/DesignSystem/Buttons.uss" />
    <ui:Style src="project://database/Packages/com.sinanata.designsystem/Resources/UI/Styles/DesignSystem/Badges.uss" />
    <ui:Style src="project://database/Packages/com.sinanata.designsystem/Resources/UI/Styles/DesignSystem/Cards.uss" />
    <ui:Style src="project://database/Packages/com.unity.uitoolkitextensions/Runtime/Styles/UIToolkitExtensionsControlStyles.uss" />
    <ui:Style src="project://database/Assets/UI/Styles/zoboui_generated.uss" />
    <ui:Style src="OpenSource_Showcase.uss" />

    <ui:VisualElement name="showcase-root" class="showcase-root">
        <ui:ScrollView class="showcase-scroll">
            <ui:VisualElement class="showcase-header">
                <ui:Label text="Open Source UI Frameworks Integration Showcase" class="showcase-title" />
                <ui:Label text="ZoboUI Utility Classes + UITK Design System Tokens + UI Extensions Custom Elements" class="showcase-subtitle" />
            </ui:VisualElement>

            <ui:VisualElement class="showcase-grid">
                <ui:VisualElement class="showcase-card">
                    <ui:VisualElement class="showcase-card-header">
                        <ui:Label text="1. ZoboUI Utility Engine" class="showcase-card-title" />
                        <ui:Label text="Utility First" class="showcase-badge" />
                    </ui:VisualElement>
                    <ui:VisualElement class="component-group">
                        <ui:Label text="Layout &amp; Flex Utilities (.items-center, .content-center)" class="group-caption" />
                        <ui:VisualElement class="items-center content-center row-elements flex-preview-box">
                            <ui:Label text="Flex Item Alpha" class="item-alpha" />
                            <ui:Label text="•" class="item-sep" />
                            <ui:Label text="Flex Item Beta" class="item-beta" />
                            <ui:Label text="•" class="item-sep" />
                            <ui:Label text="Centered Content" class="item-gamma" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="component-group">
                        <ui:Label text="Auto-Generated USS Classes (~455KB)" class="group-caption" />
                        <ui:Label text="ZoboUI scans config and generates maintainable utility classes mimicking Tailwind CSS workflow in Unity UI Toolkit." class="desc-text" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="showcase-card">
                    <ui:VisualElement class="showcase-card-header">
                        <ui:Label text="2. UI Toolkit Design System" class="showcase-card-title" />
                        <ui:Label text="Design Tokens" class="showcase-badge" />
                    </ui:VisualElement>
                    <ui:VisualElement class="component-group">
                        <ui:Label text="Token-Driven Buttons (.ds-btn)" class="group-caption" />
                        <ui:VisualElement class="row-elements">
                            <ui:Button text="Primary" class="ds-btn ds-btn--primary" />
                            <ui:Button text="Secondary" class="ds-btn ds-btn--secondary" />
                            <ui:Button text="Danger" class="ds-btn ds-btn--danger" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="component-group">
                        <ui:Label text="Token-Driven Badges (.ds-badge)" class="group-caption" />
                        <ui:VisualElement class="row-elements">
                            <ui:Label text="COMMON" class="ds-badge ds-badge--common" />
                            <ui:Label text="RARE" class="ds-badge ds-badge--rare" />
                            <ui:Label text="EPIC" class="ds-badge ds-badge--epic" />
                            <ui:Label text="LEGENDARY" class="ds-badge ds-badge--legendary" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="showcase-card">
                    <ui:VisualElement class="showcase-card-header">
                        <ui:Label text="3. Unity UI Extensions" class="showcase-card-title" />
                        <ui:Label text="Custom Controls" class="showcase-badge" />
                    </ui:VisualElement>
                    <ui:VisualElement class="component-group">
                        <ui:Label text="Gradient Pill Button (&lt;ext:PillButton&gt;)" class="group-caption" />
                        <ext:PillButton text="Pill Interactive Action" inner-color="#2563EB" outer-color="#9333EA" />
                    </ui:VisualElement>
                    <ui:VisualElement class="component-group">
                        <ui:Label text="Step Progress Bar (&lt;ext:StepProgressBar&gt;)" class="group-caption" />
                        <ext:StepProgressBar current-steps="3" max-steps="5" inner-color="#10B981" outer-color="#3B82F6" class="progress-bar-preview" />
                    </ui:VisualElement>
                    <ui:VisualElement class="component-group">
                        <ui:Label text="Rounded Input Field (&lt;ext:RoundedInputField&gt;)" class="group-caption" />
                        <ext:RoundedInputField placeholder="Enter system command or query..." class="input-preview" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="showcase-card">
                    <ui:VisualElement class="showcase-card-header">
                        <ui:Label text="4. Antigravity Trace &amp; Architecture" class="showcase-card-title" />
                        <ui:Label text="Pipeline Tool" class="showcase-badge" />
                    </ui:VisualElement>
                    <ui:VisualElement class="component-group">
                        <ui:Label text="Tool Status &amp; Integration" class="group-caption" />
                        <ui:Label text="• antigravity-trace: Installed at d:/repos/tools/antigravity-trace" class="desc-bullet" />
                        <ui:Label text="• PanGui: Closed-beta (deferred safely)" class="desc-bullet" />
                        <ui:Label text="• UI Token Pipeline: Cleanly decoupled with 0 compiler errors" class="desc-bullet" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
