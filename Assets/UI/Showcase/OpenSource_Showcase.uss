.showcase-root {
    width: 100%;
    height: 100%;
    background-color: #0b0f17;
    padding: 24px;
    flex-direction: column;
}

.showcase-scroll {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.showcase-header {
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.showcase-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: #ffffff;
    margin-bottom: 6px;
}

.showcase-subtitle {
    font-size: 14px;
    color: #94a3b8;
}

.showcase-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.showcase-card {
    width: 48%;
    min-width: 320px;
    margin-bottom: 20px;
    background-color: #161e2e;
    border-radius: 12px;
    border-width: 1px;
    border-color: #27354a;
    padding: 16px;
}

.showcase-card-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.showcase-card-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #38bdf8;
}

.showcase-badge {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-radius: 4px;
    font-size: 11px;
    -unity-font-style: bold;
    background-color: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
}

.component-group {
    margin-bottom: 12px;
}

.group-caption {
    font-size: 12px;
    color: #64748b;
    margin-bottom: 6px;
    -unity-font-style: bold;
}

.row-elements {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.row-elements > * {
    margin-right: 8px;
    margin-bottom: 8px;
}

.flex-preview-box {
    background-color: #1e293b;
    padding: 12px;
    border-radius: 8px;
}

.item-alpha {
    color: #38bdf8;
    font-size: 13px;
    -unity-font-style: bold;
}

.item-sep {
    color: #64748b;
}

.item-beta {
    color: #a855f7;
    font-size: 13px;
    -unity-font-style: bold;
}

.item-gamma {
    color: #22c55e;
    font-size: 13px;
    -unity-font-style: bold;
}

.desc-text {
    color: #cbd5e1;
    font-size: 12px;
    white-space: normal;
}

.desc-bullet {
    color: #cbd5e1;
    font-size: 12px;
    margin-top: 4px;
}

.progress-bar-preview {
    height: 18px;
    margin-top: 4px;
}

.input-preview {
    margin-top: 4px;
}
