<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="UIGallery.uss" />
    <ui:VisualElement name="gallery-root" class="gallery-root">
        <ui:VisualElement class="gallery-header">
            <ui:VisualElement class="gallery-title-box">
                <ui:Label text="STUDYGAME UI ARCHIVE / GALLERY" class="gallery-title" />
                <ui:Label text="프로젝트에 구현된 전체 UI 템플릿 목록 (클릭하여 전체 화면으로 상세 검사)" class="gallery-subtitle" />
            </ui:VisualElement>
            <ui:Label name="gallery-count-badge" text="10 Templates" class="gallery-count-badge" />
        </ui:VisualElement>

        <ui:ScrollView class="gallery-scroll" vertical-scroller-visibility="Auto">
            <ui:VisualElement name="gallery-grid" class="gallery-grid" />
        </ui:ScrollView>

        <ui:VisualElement name="inspector-overlay" class="inspector-overlay hidden">
            <ui:VisualElement class="inspector-top-bar">
                <ui:VisualElement class="inspector-title-container">
                    <ui:Label text="INSPECTOR" class="inspector-badge" />
                    <ui:Label name="inspector-title" text="Template Name" class="inspector-title" />
                </ui:VisualElement>
                <ui:Button name="inspector-close-btn" text="← 갤러리로 돌아가기 (Close)" class="inspector-close-btn" />
            </ui:VisualElement>
            <ui:VisualElement name="inspector-viewport" class="inspector-content-viewport" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
