.dialogue-overlay {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 30px;
    background-color: rgba(0, 0, 0, 0.4);
}

.dialogue-box {
    width: 85%;
    min-height: 240px;
    background-color: rgba(22, 25, 34, 0.95);
    border-width: 2px;
    border-color: #4A5568;
    border-radius: 12px;
    padding: 20px;
    flex-direction: row;
    position: relative;
}

.ap-display-label {
    position: absolute;
    top: 15px;
    right: 20px;
    font-size: 15px;
    font-style: bold;
    color: #ECC94B;
    background-color: #1A202C;
    padding: 4px 10px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #D69E2E;
}

.character-standing {
    width: 140px;
    height: 180px;
    margin-right: 20px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.dialogue-content {
    flex-grow: 1;
    flex-direction: column;
    justify-content: space-between;
}

.speaker-name {
    font-size: 22px;
    font-style: bold;
    color: #63B3ED;
    margin-bottom: 8px;
}

.dialogue-text {
    font-size: 17px;
    color: #E2E8F0;
    white-space: normal;
    margin-bottom: 15px;
}

.choices-container {
    flex-direction: column;
    align-items: flex-end;
}

.choice-button {
    background-color: #2A2E39;
    color: #EDF2F7;
    border-width: 1px;
    border-color: #4A5568;
    border-radius: 8px;
    padding: 10px 18px;
    margin-top: 6px;
    font-size: 15px;
    transition-duration: 0.15s;
    transition-property: background-color, border-color, scale;
}

.choice-button:hover {
    background-color: #3A4254;
    border-color: #63B3ED;
    scale: 1.02;
}

.choice-button:active {
    background-color: #1A202C;
    border-color: #3182CE;
    scale: 0.98;
}

.question-bar {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
    width: 100%;
}

.custom-question-field {
    flex-grow: 1;
    flex-shrink: 1;
    width: 0;
    min-width: 0;
    height: 36px;
    margin-right: 10px;
}

.custom-question-field .unity-text-field__input {
    background-color: #1A202C;
    color: #EDF2F7;
    border-color: #4A5568;
    border-radius: 6px;
    padding: 0 10px;
}

.send-question-button {
    height: 36px;
    padding: 0 16px;
    background-color: #3182CE;
    color: #FFFFFF;
    border-radius: 6px;
    font-size: 14px;
    border-width: 0;
    flex-shrink: 0;
}

.send-question-button:hover {
    background-color: #2B6CB0;
}

.loading-indicator {
    font-size: 13px;
    color: #ECC94B;
    font-style: italic;
    margin-left: 10px;
    display: none;
}
