.skill-deck-container {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 250px;
    background-color: rgba(10, 15, 30, 0.85);
    border-top-width: 2px;
    border-top-color: #4facfe;
    align-items: center;
    justify-content: flex-start;
    padding-top: 20px;
    padding-bottom: 20px;
}

.skill-instruction {
    color: white;
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 20px;
    text-shadow: 0 0 10px #4facfe;
}

.card-list {
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
    flex-grow: 1;
    width: 100%;
}

.skill-card {
    width: 180px;
    margin-left: 15px;
    margin-right: 15px;
    background-color: rgba(30, 40, 60, 0.9);
    border-radius: 15px;
    border-width: 2px;
    border-color: #3b5998;
    align-items: center;
    justify-content: center;
    transition: scale 0.2s, background-color 0.2s;
}

.skill-card:hover {
    scale: 1.05;
    background-color: rgba(60, 80, 120, 0.9);
    border-color: #00f2fe;
}

.skill-card:active {
    scale: 0.95;
    background-color: rgba(100, 150, 200, 0.9);
}

.hotkey-label {
    position: absolute;
    top: 10px;
    left: 10px;
    color: #ffd700;
    font-size: 18px;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 5px;
    padding: 2px 8px;
}

.skill-name {
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.skill-desc {
    color: #aaaaaa;
    font-size: 16px;
    -unity-font-style: italic;
}
