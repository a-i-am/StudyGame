/* PremiumTheme.uss - Global Styles for StudyGame UI */

/* 1. Global Variables & Roots */
:root {
    --bg-glass: rgba(15, 18, 25, 0.85);
    --bg-glass-light: rgba(30, 35, 50, 0.7);
    --bg-panel: rgba(22, 26, 36, 0.95);
    --bg-panel-hover: rgba(35, 42, 60, 0.95);
    
    --accent-cyan: #00E5FF;
    --accent-magenta: #FF00FF;
    --accent-blue: #3A86FF;
    
    --text-primary: #FFFFFF;
    --text-secondary: #A0ABC0;
    --text-muted: #606A80;
    
    --border-subtle: rgba(255, 255, 255, 0.1);
    --border-accent: rgba(0, 229, 255, 0.4);
    
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 16px;
    --radius-xl: 24px;
}

/* 2. Glassmorphism Panels */
.glass-panel {
    background-color: var(--bg-glass);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-lg);
    /* For unity, blur isn't natively supported in USS without custom shaders in 2021/2022, so we rely on transparency */
}

.panel-container {
    background-color: var(--bg-panel);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-md);
    overflow: hidden;
}

/* 3. Typography */
.text-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--text-primary);
    text-shadow: 0px 2px 4px rgba(0,0,0,0.5);
    letter-spacing: 2px;
}

.text-subtitle {
    font-size: 16px;
    -unity-font-style: normal;
    color: var(--accent-cyan);
    letter-spacing: 1px;
}

.text-body {
    font-size: 14px;
    color: var(--text-secondary);
    white-space: normal;
}

.text-small {
    font-size: 12px;
    color: var(--text-muted);
}

/* 4. Interactive Elements (Buttons, Slots) */
.premium-btn {
    background-color: var(--bg-glass-light);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-md);
    padding: 10px 20px;
    color: var(--text-primary);
    font-size: 14px;
    -unity-font-style: bold;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.2s, 0.2s, 0.15s;
    transition-timing-function: ease-out, ease-out, ease-out-back;
}

.premium-btn:hover {
    background-color: var(--bg-panel-hover);
    border-color: var(--accent-cyan);
    scale: 1.05;
}

.premium-btn:active {
    scale: 0.95;
    background-color: var(--accent-blue);
}

/* 5. Inventory & Item Slots */
.item-slot {
    width: 70px;
    height: 70px;
    background-color: var(--bg-glass-light);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-sm);
    margin: 5px;
    align-items: center;
    justify-content: center;
    transition-property: border-color, background-color, scale;
    transition-duration: 0.2s, 0.2s, 0.1s;
}

.item-slot:hover {
    border-color: var(--accent-cyan);
    background-color: var(--bg-panel-hover);
    scale: 1.08;
}

.item-slot:active {
    scale: 0.95;
}

.item-slot.selected {
    border-color: var(--accent-magenta);
    border-width: 2px;
    background-color: rgba(255, 0, 255, 0.1);
}

.item-icon {
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
}

/* 6. Tags */
.tag-badge {
    background-color: rgba(255,255,255,0.1);
    border-radius: 12px;
    padding: 2px 8px;
    margin-right: 4px;
    margin-bottom: 4px;
    font-size: 11px;
    color: var(--text-secondary);
}

.tag-badge.logic { background-color: rgba(0, 229, 255, 0.2); color: var(--accent-cyan); border-color: var(--accent-cyan); border-width: 1px; }
.tag-badge.emotional { background-color: rgba(255, 0, 255, 0.2); color: var(--accent-magenta); border-color: var(--accent-magenta); border-width: 1px; }
.tag-badge.rare { background-color: rgba(255, 215, 0, 0.2); color: #FFD700; border-color: #FFD700; border-width: 1px; }

/* 7. ScrollView Customization */
.unity-scroll-view {}
.unity-scroller { width: 12px; }
.unity-base-slider__dragger { background-color: var(--border-subtle); border-radius: 6px; }
.unity-base-slider__dragger:hover { background-color: var(--text-muted); }
.unity-base-slider__tracker { background-color: rgba(0,0,0,0.2); border-width: 0; }

.border-cyan { border-color: var(--accent-cyan); }
.border-magenta { border-color: var(--accent-magenta); }
.border-subtle { border-color: var(--border-subtle); }
.bg-subtle-divider { background-color: var(--border-subtle); }
.text-magenta { color: var(--accent-magenta); }
.border-left-cyan { border-left-color: var(--accent-cyan); }

