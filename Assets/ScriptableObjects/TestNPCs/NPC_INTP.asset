  personalityDescription: "\uB9E4\uC6B0 \uB17C\uB9AC\uC801\uC774\uACE0 \uBD84\uC11D\uC801\uC774\uBA70,
    \uAC10\uC815\uC801\uC778 \uACF5\uAC10\uBCF4\uB2E4\uB294 \uC6D0\uB9AC \uADDC\uBA85\uACFC
