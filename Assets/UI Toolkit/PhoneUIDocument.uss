.phone-frame {
    width: 380px;
    height: 640px;
    background-color: rgba(18, 22, 32, 0.95);
    border-width: 2px;
    border-color: rgba(70, 90, 120, 0.5);
    border-radius: 24px;
    padding: 16px;
    flex-direction: column;
    justify-content: space-between;
    align-self: center;
    margin: auto;
    color: rgb(240, 240, 245);
}

.profile-bar {
    height: 70px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(28, 36, 52, 0.9);
    border-radius: 14px;
    padding-left: 12px;
    padding-right: 12px;
    margin-bottom: 12px;
    border-width: 1px;
    border-color: rgba(80, 110, 150, 0.3);
}

.profile-image {
    width: 50px;
    height: 50px;
    border-radius: 25px;
    background-color: rgba(60, 80, 110, 0.8);
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 12px;
}

.sender-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(240, 245, 255);
}

.message-scroll {
    flex-grow: 1;
    background-color: rgba(24, 30, 44, 0.7);
    border-radius: 14px;
    padding: 12px;
    border-width: 1px;
    border-color: rgba(80, 110, 150, 0.2);
}

.sns-bubble {
    background-color: rgba(45, 60, 88, 0.9);
    border-radius: 12px;
    padding: 10px 14px;
    margin-bottom: 10px;
    max-width: 85%;
    align-self: flex-start;
}

.sns-bubble-text {
    font-size: 13px;
    color: rgb(235, 240, 250);
    white-space: normal;
}
