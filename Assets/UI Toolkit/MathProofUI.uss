.root-container {
    width: 100%;
    height: 100%;
    position: absolute;
    background-color: rgba(0, 0, 0, 0);
    flex-direction: column;
    justify-content: space-between;
    padding: 20px;
    font-size: 14px;
    color: rgb(240, 240, 245);
}

.top-header-container {
    width: 100%;
    align-items: center;
    justify-content: flex-start;
    margin-top: 10px;
}

.alert-banner-box {
    background-color: rgba(18, 28, 46, 0.85);
    border-width: 1px;
    border-color: rgba(90, 145, 215, 0.45);
    border-radius: 6px;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 6px;
    padding-bottom: 6px;
    align-items: center;
}

.alert-banner-header {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    letter-spacing: 2px;
}

.formula-display-box {
    margin-top: 24px;
    background-color: rgba(22, 34, 54, 0.88);
    border-width: 1px;
    border-color: rgba(100, 160, 230, 0.5);
    border-radius: 6px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.formula-text {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.hp-badge-box {
    margin-top: 8px;
    background-color: rgba(14, 20, 32, 0.8);
    border-width: 1px;
    border-color: rgba(80, 130, 195, 0.35);
    border-radius: 12px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 3px;
    padding-bottom: 3px;
}

.hp-badge-text {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(220, 235, 255);
}

.bottom-hud-container {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    width: 100%;
    height: 200px;
}

.player-profile-card {
    width: 150px;
    height: 190px;
    background-color: rgba(16, 22, 34, 0.85);
    border-width: 1px;
    border-color: rgba(70, 120, 180, 0.4);
    border-radius: 8px;
    padding: 6px;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
}

.player-portrait-image {
    width: 100%;
    height: 146px;
    border-radius: 6px;
    background-image: url('project://database/Assets/Textures/player_portrait.png');
    background-color: rgba(25, 36, 56, 0.6);
    -unity-image-scale-mode: scale-to-fit;
}

.mental-bar-badge {
    width: 100%;
    background-color: rgba(18, 36, 30, 0.85);
    border-width: 1px;
    border-color: rgba(50, 180, 120, 0.5);
    border-radius: 4px;
    padding-top: 3px;
    padding-bottom: 3px;
    align-items: center;
}

.mental-bar-text {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(110, 235, 170);
}

.deck-and-slot-area {
    flex-grow: 1;
    margin-left: 14px;
    margin-right: 14px;
    height: 190px;
    flex-direction: column;
    justify-content: flex-end;
}

.deck-section-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(160, 190, 225);
    margin-bottom: 6px;
}

.deck-row-container {
    flex-direction: row;
    align-items: center;
}

.skill-deck-scroll-view {
    flex-grow: 1;
    height: 160px;
}

.skill-card {
    width: 88px;
    height: 152px;
    background-color: rgba(18, 28, 46, 0.85);
    border-width: 1px;
    border-color: rgba(80, 140, 210, 0.4);
    border-radius: 8px;
    margin-right: 6px;
    padding: 6px;
    justify-content: space-between;
    align-items: center;
}

.skill-card-selected {
    border-color: rgb(120, 220, 255);
    border-width: 2px;
    background-color: rgba(30, 56, 90, 0.95);
}

.skill-icon-area {
    height: 56px;
    justify-content: center;
    align-items: center;
}

.skill-icon-text {
    font-size: 24px;
    color: rgb(120, 220, 255);
}

.skill-title-text {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.skill-sub-text {
    font-size: 10px;
    color: rgb(150, 185, 225);
    -unity-text-align: middle-center;
    white-space: normal;
}

.target-slot-group {
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
}

.target-slot-card {
    width: 80px;
    height: 152px;
    background-color: rgba(18, 28, 46, 0.85);
    border-width: 2px;
    border-color: rgba(90, 150, 225, 0.5);
    border-radius: 8px;
    justify-content: center;
    align-items: center;
}

.target-slot-icon {
    font-size: 26px;
    color: rgb(120, 200, 255);
}

.dial-gauge-wrapper {
    margin-left: 10px;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 90px;
    height: 70px;
}

.dial-gauge-circle {
    width: 60px;
    height: 60px;
    border-width: 3px;
    border-color: rgba(90, 150, 225, 0.6);
    border-radius: 30px;
    justify-content: center;
    align-items: center;
    background-color: rgba(15, 24, 40, 0.5);
}

.dial-gauge-pointer {
    width: 2px;
    height: 20px;
    background-color: rgb(120, 200, 255);
    transform-origin: bottom center;
}

.dial-value-box {
    position: absolute;
    right: 0px;
    top: 20px;
    background-color: rgba(18, 28, 46, 0.85);
    border-width: 1px;
    border-color: rgba(90, 150, 225, 0.4);
    border-radius: 4px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.dial-value-text {
    font-size: 12px;
    color: rgb(220, 235, 255);
    -unity-font-style: bold;
}

.boss-info-card {
    width: 170px;
    height: 190px;
    background-color: rgba(14, 18, 28, 0.88);
    border-width: 1px;
    border-color: rgba(180, 50, 60, 0.6);
    border-radius: 8px;
    padding: 10px;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
}

.boss-info-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 120, 130);
    margin-bottom: 2px;
}

.boss-info-desc {
    font-size: 11px;
    color: rgb(220, 225, 235);
    -unity-text-align: middle-center;
    white-space: normal;
    line-height: 15px;
}

.boss-info-weakness {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(255, 140, 140);
    -unity-text-align: middle-center;
    white-space: normal;
}
