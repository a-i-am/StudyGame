  Properties:
  - PropertyName: "[Phase 0] \uD504\uB864\uB85C\uADF8 \uBC0F \uD544\uB4DC \uD0D0\uD5D8
      (\uAE30\uD604\uC0C1 \uBC1C\uC0DD) (SNS)"
    Type: 5
    StringValue: 
    FloatValue: 0
    ColorValue: {r: 1, g: 1, b: 1, a: 1}
    AssetValue: {fileID: 0}
    TableColumns:
    - "\uACC4\uC815\uBA85"
    - "\uB0B4\uC6A9"
    TableRows:
    - Cells:
      - "@School_Notice [\uACF5\uC9C0]"
      - "\uC624\uB298 \uAE09\uC2DD \uBA54\uB274 \uC911 \uC54C\uB808\uB974\uAE30 \uC720\uBC1C
        \uBB3C\uC9C8(\uB545\uCF69)\uC774 \uD3EC\uD568\uB418\uC5B4..."
    - Cells:
      - '@Mint_Choco [Public]'
      - "\uC544 \uB9E4\uC810 \uBC8C\uC368 \uBE75 \uB2E4 \uD138\uB9BC \u3160\u3160\u3160
        \uB0B4 \uCD08\uCF54\uC18C\uB77C\uBE75 \u3160\u3160"
    - Cells:
      - '@Escape_Library [Public]'
      - "\uC57C 3\uC5F4\uB78C\uC2E4 \uBB38 \uC548 \uC5F4\uB824. \uC190\uC7A1\uC774\uAC00
        \uC544\uC608 \uC548 \uB3CC\uC544\uAC00\uB294\uB370??"
    - Cells:
      - '@Unknown_032 [Public]'
      - "\uC548\uC5D0 \uBB34\uC2A8 \uC77C \uB09C \uAC70 \uC544\uB0D0? \uC774\uC0C1\uD55C
        \uBE5B \uAC19\uC740 \uAC8C \uC0C8\uC5B4 \uB098\uC624\uB294\uB370."
    - Cells:
      - '@Energy_Drink_AD [Ad]'
      - "\uBC24\uC0D8 \uACF5\uBD80\uC5D4 \uC5ED\uC2DC \uD0C0\uC6B0\uB9B0 2000mg!
        \uC9C0\uAE08 1+1 \uD589\uC0AC \uC911!"
    ShowAsBadge: 1
  - PropertyName: "[Phase 1] \uB300\uD654 A (\uB3C4\uC601 \uCCAB \uC870\uC6B0) (\uB300\uD654)"
    Type: 5
    StringValue: 
    FloatValue: 0
    ColorValue: {r: 1, g: 1, b: 1, a: 1}
    AssetValue: {fileID: 0}
    TableColumns:
    - "\uD654\uC790"
    - "\uB300\uC0AC"
    TableRows:
    - Cells:
      - "\uB3C4\uC601"
      - "\uB3C5\uB9BD \uBCC0\uC778\uC740 \uBC30\uC81C\uD55C\uB2E4. \uD1B5\uC81C\uB41C
        \uD658\uACBD\uB9CC\uC774 \uC644\uBCBD\uD55C \uC218\uB834\uC744 \uBCF4\uC7A5\uD558\uB2C8\uAE4C.
        \uB098\uAC00."
    - Cells:
      - "\uB3C4\uC601"
      - "\uC2DC\uAC01\uC801 \uC624\uCC28. \uAD74\uC808\uB960\uC758 \uBB38\uC81C\uC77C
        \uBFD0\uC774\uC57C. 1\uB4F1\uAE09 \uCEF7\uC740 96\uC810. \uC624\uCC28 \uD55C\uB3C4\uB294
        0.04... \uC544\uB2C8, 0\uC774\uC5B4\uC57C \uD574."
    ShowAsBadge: 1
