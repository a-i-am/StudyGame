    TableRows:
    - Cells:
      - '@Fashion_Trend_AD [Ad]'
      - "\uC9C0\uAE08 \uC804\uAD50\uC0DD\uC774 \uB2E4 \uC785\uB294 \uADF8 \uBC14\uB78C\uB9C9\uC774!
        \uB108\uB9CC \uC5C6\uC73C\uBA74 \uC655\uB530 \uD655\uC815? \uD2B9\uAC00 \uD560\uC778!"
    - Cells:
      - '@Escape_Library [Public]'
      - "\uC0AC\uD68C\uC2E4 \uC65C \uC800\uB798? \uCC45\uC0C1\uB4E4\uC774 \uC9C0\uB4E4\uB07C\uB9AC
        \uB9C9 \uC6C0\uC9C1\uC774\uB294\uB370??"
    - Cells:
      - '@Tired_Runner [Public]'
      - "\uC57C \uC800\uAE30 \uC6D0 \uC548\uC73C\uB85C \uB4E4\uC5B4\uAC00\uC9C0 \uB9C8\uB77C.
        \uC544\uAE4C \uB204\uAC00 \uBC1C \uC798\uBABB \uB514\uB3A0\uB2E4\uAC00 \uC885\uC774
        \uBB49\uCE58\uC5D0 \uD30C\uBB3B\uD600\uC11C \uAE30\uC808\uD568."
    ShowAsBadge: 1
  - PropertyName: "[Phase 1] \uB300\uD654 A (\uC9C0\uC548 \uCCAB \uC870\uC6B0) (\uB300\uD654)"
