        \uAC8C \uB0AB\uC796\uC544."
    - Cells:
      - "\uC9C0\uC548"
      - "\uB2E4\uB4E4 \uADF8\uB807\uAC8C \uD558\uB2C8\uAE4C. \uBB34\uB9AC\uC5D0\uC11C
