    TableRows:
    - Cells:
      - '@Cloud_Gazer [Public]'
      - "\uC624\uB298 \uB0A0\uC528 \uBBF8\uCCE4\uB2E4. \uC57C\uC790 \uC9F8\uACE0
        \uD55C\uAC15 \uAC00\uACE0 \uC2F6\uB2E4..."
    - Cells:
      - '@Listening_Test_Hater [Public]'
      - "\uC5B4\uD559\uC2E4 \uCABD \uAC00\uC9C0 \uB9C8\uC148. \uC790\uAFB8 \uB0B4
        \uC18D\uB9C8\uC74C\uC774\uB791 \uC815\uBC18\uB300\uB418\uB294 \uC18C\uB9AC\uAC00
        \uB4E4\uB824."
    - Cells:
      - '@Grammar_Master_AD [Ad]'
      - "\uC601\uBB38\uBC95 3\uC8FC \uC644\uC131 \uD2B9\uAC15! \uC9C0\uAE08 \uC218\uAC15\uC2E0\uCCAD
        \uC2DC \uB2E8\uC5B4\uC7A5 \uBB34\uB8CC \uC99D\uC815!"
    - Cells:
      - '@Coffee_Addict [Public]'
      - "\uADFC\uB370 \u3148\u3141\uC774\uB294 \uBB34\uC870\uAC74 \uB2E4 \uC88B\uB2E4\uACE0\uB9CC
        \uD558\uB2C8\uAE4C \uC880 \uAC70\uB9AC\uAC00 \uC548 \uC881\uD600\uC9C0\uB294
        \uB290\uB08C?"
    ShowAsBadge: 1
  - PropertyName: "[Phase 1] \uB300\uD654 A (\uC9C0\uBBFC \uCCAB \uC870\uC6B0) (\uB300\uD654)"
