  NodeTitle: "[Social] 11. (\uAC00)\uC758 \uADFC\uB300 \uC11C\uC591 \uC0AC\uC0C1\uAC00
    \uAC11, \uC744\uC758 ..."
  TemplateType: "\uAE30\uBBF9 (Anomaly)"
  ThemeColorHex: '#FF9933'
