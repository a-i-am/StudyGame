  NodeTitle: "[Science] 7. \uADF8\uB9BC (\uAC00)\uC640 \uAC19\uC774 \uB9C8\uCC30\uC774
    \uC5C6\uB294 \uC218\uD3C9\uBA74\uC5D0..."
  TemplateType: "\uAE30\uBBF9 (Anomaly)"
