  Properties:
  - PropertyName: Original Formula
    Type: 0
    StringValue: "1. \uB2E4\uC74C\uC740 Na(\uE0F7)\uACFC NaCl(\uE0F7)\uC758 \uACB0\uC815
      \uAD6C\uC870\uC5D0 \uB300\uD55C \uC790\uB8CC\uC774\uB2E4. Na(\uE0F7)\uC758 
      \uB2E8\uC704 \uC138\uD3EC\uB294 \uD55C \uBCC0\uC758 \uAE38\uC774\uAC00 \uE0E5\uC778
      \uC815\uC721\uBA74\uCCB4\uC774\uB2E4. \u25E6Na(\uE0F7)\uC758 \uB2E8\uC704 \uC138\uD3EC\uC5D0
      \uD3EC\uD568\uB41C \uC6D0\uC790 \uC218\uB294  \u3260 \uC774\uB2E4. \u25E6NaCl(\uE0F7)\uC740 
      \u3261  \uACB0\uC815\uC774\uB2E4. \uB2E4\uC74C \uC911 \u3260\uACFC \u3261\uC73C\uB85C
      \uAC00\uC7A5 \uC801\uC808\uD55C \uAC83\uC740? \u3260 \u3261 \u3260 \u3261 \u3260
      \u3261 \u2460 \uE034 \uAE08\uC18D \u2461 \uE035 \uACF5\uC720 \u2462 \uE035
      \uC774\uC628 \u2463 \uE035 \uAE08\uC18D \u2464 \uE037 \uC774\uC628 2. \uB2E4\uC74C\uC740
      \uD654\uD569\uBB3C (\uAC00)\uFF5E(\uB2E4)\uC5D0 \uB300\uD55C \uC790\uB8CC\uC774\uB2E4.
      \uD654\uD569\uBB3C (\uAC00) (\uB098) (\uB2E4) \uAD6C\uC870\uC2DD \uBD84\uC790\uB7C9
      \uE037\uE039 \uE037\uE037 \uE037\uE037 \uAE30\uC900 \uB053\uB294\uC810(\u2103)
      \uE03A\uE03B \uE035\uE034 \uE046\uE037\uE035 \u25E6\uC561\uCCB4 \uC0C1\uD0DC\uC5D0\uC11C
      (\uAC00) \uBD84\uC790 \uC0AC\uC774\uC5D0  \u3260  \uACB0\uD569\uC774 \uC874\uC7AC\uD55C\uB2E4.
      \u25E6\uC561\uCCB4 \uC0C1\uD0DC\uC5D0\uC11C \uBD84\uC790 \uC0AC\uC774\uC5D0
      \uBD84\uC0B0\uB825\uC774 \uC874\uC7AC\uD558\uB294 \uD654\uD569\uBB3C\uC740 
      \uBAA8\uB450  \u3261 \uAC00\uC9C0\uC774\uB2E4. \uB2E4\uC74C \uC911 \u3260\uACFC
      \u3261\uC73C\uB85C \uAC00\uC7A5 \uC801\uC808\uD55C \uAC83\uC740? \u3260 \u3261
      \u3260 \u3261 \u3260 \u3261 \u2460\uAE08\uC18D \uE035 \u2461\uACF5\uC720 \uE035
      \u2462\uC218\uC18C \uE035 \u2463\uAE08\uC18D \uE036 \u2464\uC218\uC18C \uE036
      3. \uADF8\uB9BC\uC740 \uAD6C\uB9AC(Cu)\uC640 \uCCA0(Fe)\uC744 \uC804\uADF9
      \uC73C\uB85C \uC0AC\uC6A9\uD55C \uD654\uD559 \uC804\uC9C0\uC640, \uC804\uC9C0 
      \uBC18\uC751\uC774 \uC9C4\uD589\uB420 \uB54C \uC804\uC790\uC758 \uC774\uB3D9 
      \uBC29\uD5A5\uC744 \uB098\uD0C0\uB0B8 \uAC83\uC774\uB2E4.  \uC774\uC5D0 \uB300\uD55C
      \uC124\uBA85\uC73C\uB85C \uC633\uC740 \uAC83\uB9CC\uC744  <\uBCF4\uAE30>\uC5D0\uC11C
      \uC788\uB294 \uB300\uB85C \uACE0\uB978 \uAC83\uC740? (\uB2E8, \uC628\uB3C4\uB294
      \uE035\uE038\u2103\uB85C \uC77C\uC815\uD558\uACE0,  \uC74C\uC774\uC628\uC740
      \uBC18\uC751\uD558\uC9C0 \uC54A\uB294\uB2E4.) [3\uC810] <\uBCF4 \uAE30> \u3131.
      Cu(\uE0F7) \uC804\uADF9\uC740 (\uE048)\uADF9\uC774\uB2E4. \u3134. Cu(\uE0F7)
      \uC804\uADF9\uC758 \uC9C8\uB7C9\uC740 \uAC10\uC18C\uD55C\uB2E4. \u3137. \uAE08\uC18D\uC758
      \uC774\uC628\uD654 \uACBD\uD5A5\uC740 Fe \uE056Cu\uC774\uB2E4. \u2460 \u3131
      \u2461 \u3134 \u2462 \u3131, \u3137 \u2463 \u3134, \u3137 \u2464 \u3131, \u3134,
      \u3137 4. \uB2E4\uC74C\uC740 A(g)\uB85C\uBD80\uD130 B(g)\uAC00 \uC0DD\uC131\uB418\uB294
      \uBC18\uC751\uC758 \uD654\uD559 \uBC18\uC751\uC2DD\uACFC \uBC18\uC751  \uC18D\uB3C4\uC2DD\uC774\uB2E4.
      \uE0EF\uB294 \uBC18\uC751 \uC18D\uB3C4 \uC0C1\uC218\uC774\uB2E4. A(g) \u2192\uE035B(g)   
      \uE0FA\uE047\uE0EF\uE049A\uE04A \uD45C\uB294 \uC628\uB3C4 \uE013\uC5D0\uC11C
      \uE036\uAC1C\uC758 \uAC15\uCCA0 \uC6A9\uAE30\uC5D0 A(g)\uB97C \uAC01\uAC01
      \uB123\uACE0 \uBC18\uC751 \uC2DC\uD0A8 \uC2E4\uD5D8 (\uAC00)\uFF5E(\uB2E4)\uC5D0
      \uB300\uD55C \uC790\uB8CC\uC774\uB2E4. \uC2E4\uD5D8 A(g)\uC758 \uCD08\uAE30
      \uB18D\uB3C4(M) \uCCA8\uAC00\uD55C  \uCD09\uB9E4 \uBC18\uC751 \uC18D\uB3C4
      \uC0C1\uC218 (s\uE046\uE034) \uCD08\uAE30 \uBC18\uC751 \uC18D\uB3C4 (M\uFF65s\uE046\uE034)
      (\uAC00) \uE0E5 \uC5C6\uC74C \uE0EF\uE034 \uE035\uE0FA (\uB098) \uE036\uE0E5
      \uC5C6\uC74C \uE0EF\uE035 \uE039\uE0FA (\uB2E4) \uE035\uE0E5 X(\uE0F7) \uE039\uE0FA
      \uB2E4\uC74C \uC911 (\uB2E4)\uC5D0\uC11C \uCCA8\uAC00\uD55C X(\uE0F7)\uC758
      \uC885\uB958( \u3260)\uC640 \uE0EF\uE034, \uE0EF\uE035\uC758 \uD06C\uAE30 
      \uBE44\uAD50( \u3261)\uB85C \uAC00\uC7A5 \uC801\uC808\uD55C \uAC83\uC740? (\uB2E8,
      \uCD08\uAE30 \uB18D\uB3C4\uC640 \uCD09\uB9E4\uC758 \uCCA8\uAC00\uB97C  \uC81C\uC678\uD55C
      \uBC18\uC751 \uC870\uAC74\uC740 \uB3D9\uC77C\uD558\uB2E4.) \u3260 \u3261 \u3260
      \u3261 \u3260 \u3261 \u2460\uBD80\uCD09\uB9E4 \uE0EF\uE034\uE047\uE0EF\uE035
      \u2461\uBD80\uCD09\uB9E4 \uE0EF\uE034\uE056\uE0EF\uE035 \u2462\uBD80\uCD09\uB9E4
      \uE0EF\uE034\uE055\uE0EF\uE035 \u2463\uC815\uCD09\uB9E4 \uE0EF\uE034\uE047\uE0EF\uE035
      \u2464\uC815\uCD09\uB9E4 \uE0EF\uE034\uE056\uE0EF\uE035 5. \uADF8\uB9BC (\uAC00)\uB294
      X(\uE0F0)\uC640 Y(\uE0F0)\uC758 \uC99D\uAE30 \uC555\uB825 \uACE1\uC120\uC744,
      (\uB098)\uB294 \uC678\uBD80 \uC555\uB825  \uE034atm\uC5D0\uC11C \uAC19\uC740
      \uC591(mol)\uC758 X(\uE0F0)\uC640 Y(\uE0F0)\uB97C \uAC01\uAC01 \uAC00\uC5F4\uD560
      \uB54C, \uAC00\uD55C  \uC5F4\uB7C9\uC5D0 \uB530\uB978 \uC628\uB3C4\uB97C \uB098\uD0C0\uB0B8
      \uAC83\uC774\uB2E4. \u3260\uACFC \u3261\uC740 \uAC01\uAC01 X\uC640 Y \uC911 
      \uD558\uB098\uC774\uB2E4. \uC774\uC5D0 \uB300\uD55C \uC124\uBA85\uC73C\uB85C
      \uC633\uC740 \uAC83\uB9CC\uC744 <\uBCF4\uAE30>\uC5D0\uC11C \uC788\uB294 \uB300\uB85C
      \uACE0\uB978 \uAC83\uC740? <\uBCF4 \uAE30> \u3131. \uE0F8\uE034\u2103\uC5D0\uC11C
      \uBD84\uC790 \uC0AC\uC774\uC758 \uC778\uB825\uC740 X(\uE0F0)\uAC00 Y(\uE0F0)\uBCF4\uB2E4
      \uD06C\uB2E4. \u3134. \uE0F8\uE035\u2103, \uE034atm\uC5D0\uC11C Y\uC758 \uC548\uC815\uD55C
      \uC0C1\uC740 \uC561\uCCB4\uC774\uB2E4. \u3137. \uE0F8\uE036\u2103\uC5D0\uC11C
      Y(\uE0F0)\uC758 \uC99D\uAE30 \uC555\uB825\uC740 \uE034atm\uBCF4\uB2E4 \uC791\uB2E4.
      \u2460 \u3131 \u2461 \u3134 \u2462 \u3137 \u2463 \u3131, \u3134 \u2464 \u3134,
      \u3137 6. \uB2E4\uC74C\uC740 \uE035\uE038\u2103, \uE034atm\uC5D0\uC11C \uE037\uAC00\uC9C0
      \uC5F4\uD654\uD559 \uBC18\uC751\uC2DD\uC774\uB2E4. C\uE035H\uE038OH(\uE0F0)
      \u2192C\uE035H\uE037(g) \uE048H\uE035O(\uE0F0) \uE088\uE007\uE047\uE0E5kJ C\uE035H\uE038OH(\uE0F0)
      \u2192C\uE035H\uE038OH(g) \uE088\uE007\uE047\uE037\uE035kJ H\uE035O(\uE0F0)
      \u2192H\uE035O(g) \uE088\uE007\uE047\uE037\uE037kJ C\uE035H\uE038OH(g) \u2192C\uE035H\uE037(g)
      \uE048H\uE035O(g) \uE088\uE007\uE047\uE0FCkJ \uC774 \uC790\uB8CC\uB85C\uBD80\uD130
      \uAD6C\uD55C \uE0FC\uB294?"
