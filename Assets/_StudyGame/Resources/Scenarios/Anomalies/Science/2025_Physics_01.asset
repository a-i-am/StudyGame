  Properties:
  - PropertyName: Original Formula
    Type: 0
    StringValue: "1. \uADF8\uB9BC\uC740 \uC218\uC18C \uC6D0\uC790 \uBAA8\uD615\uC5D0
      \uB300\uD558\uC5EC \uD559\uC0DD A, B, C\uAC00 \uB300\uD654\uD558\uB294 \uBAA8\uC2B5
      \uC73C\uB85C, \u3260\uACFC \u3261\uC740 \uBCF4\uC5B4\uC758 \uC6D0\uC790 \uBAA8\uD615\uACFC
      \uD604\uB300 \uC6D0\uC790 \uBAA8\uD615\uC744 \uC21C\uC11C \uC5C6\uC774  \uB098\uD0C0\uB0B8
      \uAC83\uC774\uB2E4.   \uC81C\uC2DC\uD55C \uB0B4\uC6A9\uC774 \uC633\uC740 \uD559\uC0DD\uB9CC\uC744
      \uC788\uB294 \uB300\uB85C \uACE0\uB978 \uAC83\uC740? \u2460 A \u2461 C \u2462
      A, B \u2463 B, C \u2464 A, B, C 2. \uB2E4\uC74C\uC740 \uC804\uC790\uAE30\uD30C\uC758
      \uC218\uC2E0\uC5D0 \uB300\uD55C \uC124\uBA85\uC774\uB2E4. \uC548\uD14C\uB098\uC5D0
      \uC218\uC2E0\uB41C \uC804\uC790\uAE30\uD30C\uC5D0 \uC758\uD574 \uE034\uCC28 
      \uCF54\uC77C\uC5D0 \uAD50\uB958 \uC804\uB958\uAC00 \uBC1C\uC0DD\uD558\uACE0,
      \uC804\uC790\uAE30  \uC720\uB3C4\uC5D0 \uC758\uD574 \uC218\uC2E0 \uD68C\uB85C\uC758
      \uE035\uCC28 \uCF54\uC77C\uC5D0  A \uAC00 \uD750\uB978\uB2E4. \uADF8\uB9AC\uACE0
      \uC218\uC2E0 \uD68C\uB85C\uC758  B \uB97C \uC804\uC790\uAE30\uD30C\uC758 \uC9C4\uB3D9\uC218\uC640
      \uAC19\uAC8C  \uD558\uBA74 \uACF5\uBA85\uC774 \uC77C\uC5B4\uB098 \uC218\uC2E0
      \uD68C\uB85C\uC5D0 \uD750\uB974\uB294 \uC804\uB958\uC758 \uC138\uAE30\uAC00
      \uCD5C\uB300\uAC00 \uB41C\uB2E4. A, B\uB85C \uAC00\uC7A5 \uC801\uC808\uD55C
      \uAC83\uC740? A B A B \u2460\uC720\uB3C4 \uC804\uB958 \uACF5\uBA85 \uC9C4\uB3D9\uC218
      \u2461\uC720\uB3C4 \uC804\uB958 \uBB38\uD131 \uC9C4\uB3D9\uC218 \u2462 \uAD11\uC804\uB958
      \uACF5\uBA85 \uC9C4\uB3D9\uC218 \u2463 \uAD11\uC804\uB958 \uBB38\uD131 \uC9C4\uB3D9\uC218
      \u2464\uC9C1\uB958 \uC804\uB958 \uACF5\uBA85 \uC9C4\uB3D9\uC218 3. \uADF8\uB9BC\uACFC
      \uAC19\uC774 \uCD08\uC810 \uAC70\uB9AC\uAC00 \uE0EA\uC778  \uBCFC\uB85D \uB80C\uC988\uB85C\uBD80\uD130
      \uE034\uE03Dcm\uB9CC\uD07C  \uB5A8\uC5B4\uC9C4 \uC9C0\uC810\uC5D0 \uD06C\uAE30\uAC00
      \uE0EC\uC778 \uBB3C\uCCB4\uB97C  \uB193\uC558\uB354\uB2C8 \uD06C\uAE30\uAC00
      \uE007\uC778 \uC0C1\uC774 \uC0DD\uACBC\uB2E4.  \uBCFC\uB85D \uB80C\uC988\uC640
      \uC0C1 \uC0AC\uC774\uC758 \uAC70\uB9AC\uB294 \uE0E8\uC774\uACE0, \uE06D \uE0EC
      \uE007\uE047\uE035\uE053\uE038\uC774\uB2E4. \uC774\uC5D0 \uB300\uD55C \uC124\uBA85\uC73C\uB85C
      \uC633\uC740 \uAC83\uB9CC\uC744 <\uBCF4\uAE30>\uC5D0\uC11C \uC788\uB294 \uB300\uB85C
      \uACE0\uB978 \uAC83\uC740? <\uBCF4 \uAE30> \u3131. \uC0C1\uC740 \uC2E4\uC0C1\uC774\uB2E4.
      \u3134. \uE0E8\uE047\uE035\uE038cm\uC774\uB2E4. \u3137. \uE0EA\uE047\uE035\uE03Dcm\uC774\uB2E4.
      \u2460 \u3131 \u2461 \u3134 \u2462 \u3137 \u2463 \u3131, \u3137 \u2464 \u3134,
      \u3137 4. \uADF8\uB9BC (\uAC00)\uB294 \uC2A4\uD06C\uB9B0\uC73C\uB85C\uBD80\uD130
      \uE00B\uB9CC\uD07C \uCDA9\uBD84\uD788 \uBA40\uB9AC \uB5A8\uC5B4\uC9C4 \uC774\uC911
      \uC2AC\uB9BF\uC5D0  \uB2E8\uC0C9\uAD11\uC744 \uBE44\uCD94\uB294 \uBAA8\uC2B5\uC744
      \uB098\uD0C0\uB0B8 \uAC83\uC73C\uB85C, O\uC640 P\uB294 \uC2A4\uD06C\uB9B0\uC0C1\uC758 
      \uB450 \uC810\uC774\uB2E4. \uADF8\uB9BC (\uB098)\uB294 (\uAC00)\uC5D0\uC11C
      \uE00B\uC774 \uAC01\uAC01 \uE034m, \uE00B\uE0FC\uC77C \uB54C \uC2A4\uD06C\uB9B0\uC5D0 
      \uC0DD\uAE30\uB294 \uAC04\uC12D\uBB34\uB2AC\uB97C \uB098\uD0C0\uB0B8 \uAC83\uC774\uB2E4.
      O\uC5D0\uC11C\uB294 \uAC00\uC7A5 \uBC1D\uC740 \uBB34\uB2AC\uC758 \uC911\uC2EC\uC774 
      \uC0DD\uAE30\uACE0, P\uC5D0\uC11C\uB294 \uE00B\uE047\uE034m\uC77C \uB54C O\uB85C\uBD80\uD130
      \uC138 \uBC88\uC9F8 \uBC1D\uC740 \uBB34\uB2AC\uC758 \uC911\uC2EC\uC774,  \uE00B\uE047\uE00B\uE0FC\uC77C
      \uB54C O\uB85C\uBD80\uD130 \uB450 \uBC88\uC9F8 \uC5B4\uB450\uC6B4 \uBB34\uB2AC\uC758
      \uC911\uC2EC\uC774 \uC0DD\uAE34\uB2E4. \uE00B\uE0FC\uB85C \uAC00\uC7A5 \uC801\uC808\uD55C
      \uAC83\uC740? [3\uC810] \u2460 \uE06D\uE038 \uE035m \u2461 \uE06D\uE035 \uE034m 
      \u2462 \uE06D\uE036 \uE035m \u2463 \uE035m \u2464 \uE037m 5. \uADF8\uB9BC\uACFC
      \uAC19\uC774 \uAE38\uC774\uAC00 \uE00BA, \uE00BB\uC778 \uC2E4\uC5D0 \uC5F0\uACB0\uB41C
      \uC9C8\uB7C9\uC774 \uAC19\uC740 \uCD94 A, B\uB97C  \uC218\uD3C9\uBA74\uC73C\uB85C\uBD80\uD130
      \uB192\uC774\uAC00 \uAC19\uC740 \uC810 p, q\uC5D0\uC11C \uB3D9\uC2DC\uC5D0
      \uAC00\uB9CC\uD788 \uB193\uC558\uB354\uB2C8 \uAC01\uAC01  \uB2E8\uC9C4\uB3D9\uC744
      \uD558\uC600\uB2E4. A, B\uAC00 \uB193\uC778 \uC21C\uAC04\uBD80\uD130 p, q\uC5D0
      \uB3D9\uC2DC\uC5D0 \uB3C4\uB2EC\uD558\uB294 \uB370  \uAC78\uB9AC\uB294 \uCD5C\uC18C
      \uC2DC\uAC04\uC740 \uE0F8\uE03D\uC774\uB2E4. A, B\uC758 \uC9C4\uB3D9 \uC8FC\uAE30\uB294
      \uAC01\uAC01 \uE013A, \uE013B\uC774\uACE0,  \uE06D \uE00BA \uE00BB \uE047\uE06D
      \uE034\uE035\uE034 \uE034\uE03D\uE03D\uC774\uB2E4. \uC774\uC5D0 \uB300\uD55C
      \uC124\uBA85\uC73C\uB85C \uC633\uC740 \uAC83\uB9CC\uC744 <\uBCF4\uAE30>\uC5D0\uC11C
      \uC788\uB294 \uB300\uB85C \uACE0\uB978  \uAC83\uC740? (\uB2E8, \uCD94\uC758
      \uD06C\uAE30\uC640 \uC2E4\uC758 \uC9C8\uB7C9\uC740 \uBB34\uC2DC\uD55C\uB2E4.)
      <\uBCF4 \uAE30> \u3131. \uE06D \uE013A \uE013B \uE047\uE06D \uE034\uE034 \uE034\uE03D\uC774\uB2E4.
      \u3134. \uE0F8\uE03D\uE047\uE034\uE03D\uE013A\uC774\uB2E4. \u3137. A\uC640
      B\uC758 \uCD5C\uB300 \uC6B4\uB3D9 \uC5D0\uB108\uC9C0\uB294 \uAC19\uB2E4. \u2460
      \u3131 \u2461 \u3134 \u2462 \u3137 \u2463 \u3131, \u3134 \u2464 \u3134, \u3137
      6. \uADF8\uB9BC\uACFC \uAC19\uC774 \uC800\uD56D\uAC12\uC774 \uAC19\uC740 \uC800\uD56D
      \uE037\uAC1C,  \uC2A4\uC704\uCE58, \uC804\uB958\uACC4, \uC804\uC555\uC774 \uC77C\uC815\uD55C
      \uC804\uC6D0\uC73C\uB85C  \uD68C\uB85C\uB97C \uAD6C\uC131\uD558\uC600\uB2E4.
      \uC2A4\uC704\uCE58\uB97C a\uC5D0 \uC5F0\uACB0 \uD588\uC744 \uB54C, \uC804\uB958\uACC4\uC5D0
      \uD750\uB974\uB294 \uC804\uB958\uC758 \uC138\uAE30\uB294  \uE008\uE03D\uC774\uB2E4.
      \uC2A4\uC704\uCE58\uB97C b\uC5D0 \uC5F0\uACB0\uD588\uC744 \uB54C, \uC804\uB958\uACC4\uC5D0
      \uD750\uB974\uB294 \uC804\uB958\uC758 \uC138\uAE30\uB294?"
