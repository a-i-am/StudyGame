  Properties:
  - PropertyName: Original Formula
    Type: 0
    StringValue: "11. \uADF8\uB9BC\uC740 \uAE08\uC18D\uD310 P, Q\uC5D0 \uC9C4\uB3D9\uC218\uAC00
      \uE0EA, \uE035\uE0EA\uC778 \uB2E8\uC0C9\uAD11\uC744 \uAC01\uAC01 \uBE44\uCD94\uC5B4 
      \uC815\uC9C0 \uC804\uC555\uC744 \uCE21\uC815\uD558\uB294 \uAD11\uC804 \uD6A8\uACFC
      \uC2E4\uD5D8 \uC7A5\uCE58\uB97C \uB098\uD0C0\uB0B8 \uAC83\uC774\uB2E4.  \uD45C\uB294
      \uBC29\uCD9C\uB41C \uAD11\uC804\uC790\uC758 \uCD5C\uB300 \uC6B4\uB3D9 \uC5D0\uB108\uC9C0\uC5D0
      \uD574\uB2F9\uD558\uB294 \uC815\uC9C0 \uC804\uC555\uACFC  \uBB3C\uC9C8\uD30C
      \uD30C\uC7A5\uC758 \uCD5C\uC19F\uAC12\uC744 \uB098\uD0C0\uB0B8 \uAC83\uC774\uB2E4.
      \uC774\uC5D0 \uB300\uD55C \uC124\uBA85\uC73C\uB85C \uC633\uC740 \uAC83\uB9CC\uC744
      <\uBCF4\uAE30>\uC5D0\uC11C \uC788\uB294 \uB300\uB85C \uACE0\uB978  \uAC83\uC740?
      (\uB2E8, \uE0EC\uB294 \uD50C\uB791\uD06C \uC0C1\uC218\uC774\uB2E4.) [3\uC810]
      <\uBCF4 \uAE30> \u3131. \uE0A7\uE034\uE047\uE05C\uE06D\uE035\uE0A7\uE036\uC774\uB2E4.
      \u3134. Q\uC758 \uC77C\uD568\uC218\uB294 \uE06D\uE036 \uE037\uE0EC\uE0EA\uC774\uB2E4.
      \u3137. P\uC5D0 \uC9C4\uB3D9\uC218\uAC00 \uE0EA\uC778 \uB2E8\uC0C9\uAD11\uC744
      \uBE44\uCD94\uC5C8\uC744 \uB54C \uBC29\uCD9C\uB418\uB294 \uAD11\uC804\uC790\uC758 
      \uCD5C\uB300 \uC6B4\uB3D9 \uC5D0\uB108\uC9C0\uB294 \uE06D\uE036 \uE035\uE0EC\uE0EA\uC774\uB2E4.
      \u2460 \u3131 \u2461 \u3137 \u2462 \u3131, \u3134 \u2463 \u3134, \u3137 \u2464
      \u3131, \u3134, \u3137 12. \uADF8\uB9BC (\uAC00), (\uB098)\uC640 \uAC19\uC774
      \uC9C8\uB7C9\uC774 \uE0F1\uC778 \uBB3C\uCCB4\uAC00 \uBE57\uBA74\uC758 \uC810
      p\uB97C \uC9C0\uB098  \uB9C8\uCC30 \uAD6C\uAC04\uC758 \uC2DC\uC791\uC810 q\uB97C
      \uD1B5\uACFC\uD558\uC5EC \uCD5C\uACE0\uC810 r\uC5D0 \uB3C4\uB2EC\uD55C \uD6C4,
      \uB2E4\uC2DC q\uC640  p\uB97C \uC9C0\uB09C\uB2E4. (\uAC00)\uC758 \uB9C8\uCC30
      \uAD6C\uAC04\uC5D0\uC11C \uBB3C\uCCB4\uC758 \uC5ED\uD559\uC801 \uC5D0\uB108\uC9C0
      \uAC10\uC18C\uB7C9\uC740  (\uB098)\uC758 \uB9C8\uCC30 \uAD6C\uAC04\uC5D0\uC11C
      \uBB3C\uCCB4\uC758 \uC6B4\uB3D9 \uC5D0\uB108\uC9C0 \uC99D\uAC00\uB7C9\uACFC
      \uAC19\uB2E4. (\uAC00)\uC640  (\uB098)\uC758 qr \uAD6C\uAC04\uC5D0\uC11C\uB294
      \uBB3C\uCCB4\uC5D0 \uAC19\uC740 \uD06C\uAE30\uC758 \uC77C\uC815\uD55C \uB9C8\uCC30\uB825\uC774
      \uC791\uC6A9\uD55C\uB2E4.  \uBB3C\uCCB4\uC758 \uC6B4\uB3D9 \uC5D0\uB108\uC9C0\uB294
      (\uAC00)\uC758 p\uB97C \uC9C0\uB0A0 \uB54C \uE004\uE03D\uC774\uACE0, (\uAC00)\uC758
      q\uB97C \uC9C0\uB0A0 \uB54C\uC640  (\uB098)\uC758 p\uB97C \uC9C0\uB0A0 \uB54C\uAC00
      \uE004\uE034\uB85C \uAC19\uB2E4. \uE004\uE034\uC740? (\uB2E8, \uBB3C\uCCB4\uC758
      \uD06C\uAE30, \uACF5\uAE30 \uC800\uD56D, \uB9C8\uCC30 \uAD6C\uAC04 \uC678\uC758
      \uBAA8\uB4E0 \uB9C8\uCC30\uC740  \uBB34\uC2DC\uD55C\uB2E4.) [3\uC810] \u2460
      \uE06D\uE038 \uE035\uE004\uE03D \u2461 \uE06D\uE038 \uE036\uE004\uE03D \u2462
      \uE06D\uE036 \uE035\uE004\uE03D \u2463 \uE06D\uE038 \uE037\uE004\uE03D \u2464
      \uE06D\uE039 \uE038\uE004\uE03D 13. \uADF8\uB9BC\uACFC \uAC19\uC774 \uC810
      p\uC5D0\uC11C \uBB3C\uCCB4 A\uB97C  \uE048\uE0FD\uBC29\uD5A5\uC73C\uB85C \uB358\uC9C4
      \uC21C\uAC04, \uC810 q\uC5D0\uC11C  \uBB3C\uCCB4 B\uB97C \uE0FC\uCD95\uC5D0
      \uB098\uB780\uD55C \uC5F0\uC9C1\uBA74\uC0C1\uC5D0\uC11C  \uC218\uD3C9\uBA74\uACFC
      \uE0A4\uC758 \uAC01\uC73C\uB85C \uB358\uC84C\uB354\uB2C8  \uB450 \uBB3C\uCCB4\uAC00
      \uAC01\uAC01 \uD3EC\uBB3C\uC120 \uC6B4\uB3D9\uC744 \uD558\uC5EC  \uC810 r\uC5D0\uC11C
      \uB9CC\uB09C\uB2E4. p\uB294 \uC6D0\uC810 O\uB85C\uBD80\uD130  \uB192\uC774\uAC00
      \uE035\uE0E8\uC778 \uC810\uC774\uACE0, q\uB294 \uE0FC\uCD95\uACFC  \uE0FD\uCD95\uC73C\uB85C\uBD80\uD130
      \uAC01\uAC01 \uE0E8\uB9CC\uD07C \uB5A8\uC5B4\uC9C4  \uC218\uD3C9\uBA74\uC0C1\uC758
      \uC810\uC774\uB2E4. tan\uE0A4\uB294? (\uB2E8, \uBB3C\uCCB4\uC758 \uD06C\uAE30\uB294
      \uBB34\uC2DC\uD55C\uB2E4.) \u2460 \uE06D\uE035 \uE034 \u2461 \uE06D \uE05C\uE06D\uE035
      \uE034 \u2462 \uE034 \u2463 \uE05C\uE06D\uE035 \u2464 \uE035 14. \uADF8\uB9BC
      (\uAC00)\uC640 \uAC19\uC774 \uC911\uC2EC\uC774 \uC6D0\uC810 O\uC778 \uC6D0\uD615
      \uB3C4\uC120 P\uAC00 \uE0FC\uE0FD\uD3C9\uBA74\uC0C1\uC5D0  \uACE0\uC815\uB418\uC5B4
      \uC788\uACE0, \uBB34\uD55C\uD788 \uAE34 \uC9C1\uC120 \uB3C4\uC120 Q\uC640 R\uB294
      \uE0FC\uE0FD\uD3C9\uBA74\uC5D0 \uC218\uC9C1\uC73C\uB85C  \uACE0\uC815\uB418\uC5B4
      \uC788\uB2E4. P\uC640 Q\uC5D0\uB294 \uAC01\uAC01 \uC138\uAE30\uC640 \uBC29\uD5A5\uC774
      \uC77C\uC815\uD55C \uC804\uB958\uAC00 \uD750\uB974\uACE0  \uC788\uB2E4. \uADF8\uB9BC
      (\uB098)\uB294 (\uAC00)\uC758 O\uC5D0\uC11C \uC138 \uB3C4\uC120\uC758 \uC804\uB958\uC5D0
      \uC758\uD55C \uC790\uAE30\uC7A5\uC758  \uE0FD\uC131\uBD84 \uE001\uE0FD\uB97C
      R\uC5D0 \uD750\uB974\uB294 \uC804\uB958\uC758 \uC138\uAE30 \uE008R\uC5D0 \uB530\uB77C
      \uB098\uD0C0\uB0B8 \uAC83\uC774\uB2E4.  \uE008R \uE047\uE008\uE03D\uC77C \uB54C,
      O\uC5D0\uC11C \uC138 \uB3C4\uC120\uC758 \uC804\uB958\uC5D0 \uC758\uD55C \uC790\uAE30\uC7A5\uC758
      \uC138\uAE30\uB294 \uE001\uE03D\uC774\uB2E4. \uC774\uC5D0 \uB300\uD55C \uC124\uBA85\uC73C\uB85C
      \uC633\uC740 \uAC83\uB9CC\uC744 <\uBCF4\uAE30>\uC5D0\uC11C \uC788\uB294 \uB300\uB85C
      \uACE0\uB978  \uAC83\uC740? (\uB2E8, \uB3C4\uC120\uC758 \uAD75\uAE30\uB294
      \uBB34\uC2DC\uD55C\uB2E4.) <\uBCF4 \uAE30> \u3131. Q\uC640 R\uC5D0 \uD750\uB974\uB294
      \uC804\uB958\uC758 \uBC29\uD5A5\uC740 \uC11C\uB85C \uBC18\uB300\uC774\uB2E4.
      \u3134. Q\uC5D0 \uD750\uB974\uB294 \uC804\uB958\uC758 \uC138\uAE30\uB294 \uE035\uE008\uE03D\uC774\uB2E4.
      \u3137. \uE008R\uE047\uE035\uE008\uE03D\uC77C \uB54C, O\uC5D0\uC11C \uC138
      \uB3C4\uC120\uC758 \uC804\uB958\uC5D0 \uC758\uD55C \uC790\uAE30\uC7A5\uC758
      \uC138\uAE30\uB294  \uE05C\uE06D\uE035\uE001\uE03D\uC774\uB2E4. \u2460 \u3131
      \u2461 \u3134 \u2462 \u3137 \u2463 \u3131, \u3137 \u2464 \u3134, \u3137 15.
      \uADF8\uB9BC (\uAC00)\uB294 \uB3D9\uC77C\uD55C \uD3C9\uBA74\uC5D0\uC11C \uC9C8\uB7C9\uC774
      \uE00C\uC778 \uD589\uC131\uC744 \uC911\uC2EC\uC73C\uB85C  \uC6D0\uC6B4\uB3D9\uC744
      \uD558\uB294 \uC704\uC131 A\uC640, \uAC19\uC740 \uD589\uC131\uC744 \uD55C \uCD08\uC810\uC73C\uB85C
      \uD0C0\uC6D0 \uC6B4\uB3D9\uC744 \uD558\uB294  \uC704\uC131 B\uAC00 \uAC00\uC7A5
      \uAC00\uAE4C\uC6CC\uC9C4 \uC21C\uAC04\uC758 \uBAA8\uC2B5\uC744 \uB098\uD0C0\uB0B8
      \uAC83\uC774\uB2E4. \uC774\uB54C A \uC911\uC2EC\uACFC  B \uC911\uC2EC \uC0AC\uC774\uC758
      \uAC70\uB9AC\uB294 A\uC758 \uADA4\uB3C4 \uBC18\uC9C0\uB984\uACFC \uAC19\uB2E4.
      \uADF8\uB9BC (\uB098)\uB294 (\uAC00)\uC758  \uC21C\uAC04\uBD80\uD130 A, B\uC758
      \uC6B4\uB3D9 \uC5D0\uB108\uC9C0 \uE004\uB97C \uC2DC\uAC04 \uE0F8\uC5D0 \uB530\uB77C
      \uB098\uD0C0\uB0B8 \uAC83\uC774\uB2E4.  A\uC758 \uC9C8\uB7C9\uC740 \uE0F1\uC774\uACE0,
      \uACF5\uC804 \uC8FC\uAE30\uB294 \uE013\uC774\uBA70, \uC6B4\uB3D9 \uC5D0\uB108\uC9C0\uB294
      \uE004\uE03D\uC774\uB2E4.  \uE0F8\uE047\uE037\uE013\uC77C \uB54C, A \uC911\uC2EC\uACFC
      B \uC911\uC2EC \uC0AC\uC774\uC758 \uAC70\uB9AC\uB294? (\uB2E8, \uC911\uB825
      \uC0C1\uC218\uB294  \uE006\uC774\uACE0, A, B\uC5D0\uB294 \uD589\uC131\uC5D0
