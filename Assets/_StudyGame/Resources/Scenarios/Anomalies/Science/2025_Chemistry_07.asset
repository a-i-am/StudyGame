  Properties:
  - PropertyName: Original Formula
    Type: 0
    StringValue: "7. \uB2E4\uC74C\uC740 \uD559\uC0DD A\uAC00 \uC218\uD589\uD55C \uD0D0\uAD6C
      \uD65C\uB3D9\uC774\uB2E4. [\uAC00\uC124] \u25E6\uBD84\uC790\uB2F9 \uAD6C\uC131
      \uC6D0\uC790 \uC218\uAC00 \uE036\uC778 \uBD84\uC790\uC758 \uBD84\uC790 \uBAA8\uC591\uC740
      \uBAA8\uB450  \u3260 \uC774\uB2E4. [\uD0D0\uAD6C \uACFC\uC815 \uBC0F \uACB0\uACFC]
      (\uAC00) \uBD84\uC790\uB2F9 \uAD6C\uC131 \uC6D0\uC790 \uC218\uAC00 \uE036\uC778
      \uBD84\uC790\uB97C \uCC3E\uACE0, \uAC01 \uBD84\uC790\uC758 \uBD84\uC790  \uBAA8\uC591\uC744
      \uC870\uC0AC\uD558\uC600\uB2E4. (\uB098) (\uAC00)\uC5D0\uC11C \uC870\uC0AC\uD55C
      \uB0B4\uC6A9\uC744 \uD45C\uB85C \uC815\uB9AC\uD558\uC600\uB2E4. \uAC00\uC124\uC5D0
      \uC77C\uCE58\uD558\uB294 \uBD84\uC790 \uAC00\uC124\uC5D0 \uC5B4\uAE0B\uB098\uB294
      \uBD84\uC790 BeF\uE035, CO\uE035, \u2026 OF\uE035, \u3261, \u2026   [\uACB0\uB860]
      \u25E6\uAC00\uC124\uC5D0 \uC5B4\uAE0B\uB098\uB294 \uBD84\uC790\uAC00 \uC788\uC73C\uBBC0\uB85C
      \uAC00\uC124\uC740 \uC633\uC9C0 \uC54A\uB2E4. \uD559\uC0DD A\uC758 \uD0D0\uAD6C
      \uACFC\uC815 \uBC0F \uACB0\uACFC\uC640 \uACB0\uB860\uC774 \uD0C0\uB2F9\uD560
      \uB54C, \uB2E4\uC74C \uC911 \u3260\uACFC  \u3261\uC73C\uB85C \uAC00\uC7A5 \uC801\uC808\uD55C
      \uAC83\uC740? \u3260 \u3261 \u3260 \u3261 \u2460 \uC9C1\uC120\uD615 HNO \u2461
      \uC9C1\uC120\uD615 CF\uE037 \u2462 \uAD7D\uC740\uD615 HOF \u2463 \uAD7D\uC740\uD615
      FCN \u2464\uD3C9\uBA74 \uC0BC\uAC01\uD615 FCN 8. \uADF8\uB9BC\uC740 \uC218\uC18C(H)\uC640
      \uC6D0\uC18C X\uFF5EZ\uB85C  \uAD6C\uC131\uB41C \uBD84\uC790 (\uAC00)\uFF5E(\uB77C)\uC758
      \uACF5\uC720  \uC804\uC790\uC30D \uC218\uC640 \uAD6C\uC131 \uC6D0\uC18C\uC758
      \uC804\uAE30  \uC74C\uC131\uB3C4 \uCC28\uB97C \uB098\uD0C0\uB0B8 \uAC83\uC774\uB2E4. 
      (\uAC00)\uFF5E(\uB77C)\uB294 \uAC01\uAC01 H\uE0E5X\uE0E5, H\uE0E6X,  HY, HZ
      \uC911 \uD558\uB098\uC774\uACE0, \uBD84\uC790\uC5D0\uC11C  X\uFF5EZ\uB294 \uC625\uD15F
      \uADDC\uCE59\uC744 \uB9CC\uC871\uD55C\uB2E4. X\uFF5EZ\uB294 C, F, Cl\uB97C
      \uC21C\uC11C \uC5C6\uC774 \uB098\uD0C0\uB0B8  \uAC83\uC774\uACE0, \uC804\uAE30
      \uC74C\uC131\uB3C4\uB294 Y \uE056Z \uE056H\uC774\uB2E4. \uC774\uC5D0 \uB300\uD55C
      \uC124\uBA85\uC73C\uB85C \uC633\uC740 \uAC83\uB9CC\uC744 <\uBCF4\uAE30>\uC5D0\uC11C
      \uC788\uB294 \uB300\uB85C \uACE0\uB978  \uAC83\uC740? [3\uC810] <\uBCF4 \uAE30>
      \u3131. \uE0E5\uE047\uE035\uC774\uB2E4. \u3134. (\uB77C)\uC5D0\uB294 \uBB34\uADF9\uC131
      \uACF5\uC720 \uACB0\uD569\uC774 \uC788\uB2E4. \u3137. YZ\uC5D0\uC11C \uAD6C\uC131
      \uC6D0\uC18C\uC758 \uC804\uAE30 \uC74C\uC131\uB3C4 \uCC28\uB294 \uE0F1\uE046\uE0F2\uC774\uB2E4.
      \u2460 \u3131 \u2461 \u3137 \u2462 \u3131, \u3134 \u2463 \u3134, \u3137 \u2464
      \u3131, \u3134, \u3137 9. \uD45C\uB294 \uBC14\uB2E5\uC0C1\uD0DC \uB9C8\uADF8\uB124\uC298(Mg)
      \uC6D0\uC790\uC758 \uC804\uC790 \uBC30\uCE58\uC5D0\uC11C \uC804\uC790\uAC00
      \uB4E4\uC5B4  \uC788\uB294 \uC624\uBE44\uD0C8 (\uAC00)\uFF5E(\uB77C)\uC5D0
      \uB300\uD55C \uC790\uB8CC\uC774\uB2E4. \uE0F2\uC740 \uC8FC \uC591\uC790\uC218,
      \uE0F0\uC740  \uBC29\uC704(\uBD80) \uC591\uC790\uC218, \uE0F1\uE0F0\uC740 \uC790\uAE30
      \uC591\uC790\uC218\uC774\uB2E4. \uC624\uBE44\uD0C8 (\uAC00) (\uB098) (\uB2E4)
      (\uB77C) \uE06D \uE0F2\uE048\uE0F1\uE0F0 \uE034 (\uC0C1\uB313\uAC12) \uE035
      \uE0E5 \uE0E5 \uE035\uE0E5 \uE0F2\uE048\uE0F0\uE048\uE0F1\uE0F0 \uE037 \uE036
      \uE035 \uE035 \uC774\uC5D0 \uB300\uD55C \uC124\uBA85\uC73C\uB85C \uC633\uC740
      \uAC83\uB9CC\uC744 <\uBCF4\uAE30>\uC5D0\uC11C \uC788\uB294 \uB300\uB85C \uACE0\uB978
      \uAC83\uC740? <\uBCF4 \uAE30> \u3131. (\uAC00)\uC758 \uE0F0\uB294 \uE034\uC774\uB2E4.
      \u3134. \uE0F1\uE0F0\uB294 (\uB098)\uC640(\uB2E4)\uAC00 \uAC19\uB2E4. \u3137.
      \uC5D0\uB108\uC9C0 \uC900\uC704\uB294 (\uB77C) \uE056(\uB2E4)\uC774\uB2E4.
      \u2460 \u3131 \u2461 \u3137 \u2462 \u3131, \u3134 \u2463 \u3134, \u3137 \u2464
      \u3131, \u3134, \u3137 10. \uB2E4\uC74C\uC740 \uC6A9\uC561\uC758 \uBAB0 \uB18D\uB3C4\uC5D0
      \uB300\uD55C \uD559\uC0DD A\uC640 B\uC758 \uC2E4\uD5D8\uC774\uB2E4. [\uD559\uC0DD
      A\uC758 \uC2E4\uD5D8 \uACFC\uC815] (\uAC00) \uE0E5M X(\uE0E5\uE0F5) \uE034\uE03D\uE03DmL\uC5D0
      \uBB3C\uC744 \uB123\uC5B4 \uE035\uE03D\uE03DmL \uC218\uC6A9\uC561\uC744 \uB9CC\uB4E0\uB2E4.
      (\uB098) (\uAC00)\uC5D0\uC11C \uB9CC\uB4E0 \uC218\uC6A9\uC561 \uE035\uE03D\uE03DmL\uC640
      \uE03D\uE053\uE035M X(\uE0E5\uE0F5) \uE038\uE03DmL\uB97C  \uD63C\uD569\uD558\uC5EC
      \uC218\uC6A9\uC561\u2160\uC744 \uB9CC\uB4E0\uB2E4. [\uD559\uC0DD B\uC758 \uC2E4\uD5D8
      \uACFC\uC815] (\uAC00) \uE0E5M X(\uE0E5\uE0F5) \uE035\uE03D\uE03DmL\uC640 \uE03D\uE053\uE035M
      X(\uE0E5\uE0F5) \uE038\uE03DmL\uB97C \uD63C\uD569\uD558\uC5EC  \uC218\uC6A9\uC561\uC744
      \uB9CC\uB4E0\uB2E4. (\uB098) (\uAC00)\uC5D0\uC11C \uB9CC\uB4E0 \uC218\uC6A9\uC561
      \uE035\uE038\uE03DmL\uC5D0 \uBB3C\uC744 \uB123\uC5B4 \uE038\uE03D\uE03DmL \uC218\uC6A9\uC561
      \u2161\uB97C  \uB9CC\uB4E0\uB2E4. [\uC2E4\uD5D8 \uACB0\uACFC] \u25E6A\uAC00
      \uB9CC\uB4E0\u2160\uC758 \uBAB0 \uB18D\uB3C4(M) : \uE03B\uE0EF \u25E6B\uAC00
      \uB9CC\uB4E0 \u2161\uC758 \uBAB0 \uB18D\uB3C4(M) : \uE03A\uE0EF \uE06D\uE0E5
      \uE0EF\uB294? (\uB2E8, \uC628\uB3C4\uB294 \uC77C\uC815\uD558\uACE0, \uD63C\uD569
      \uC6A9\uC561\uC758 \uBD80\uD53C\uB294 \uD63C\uD569 \uC804 \uAC01  \uC6A9\uC561\uC758
      \uBD80\uD53C\uC758 \uD569\uACFC \uAC19\uB2E4.) [3\uC810] \u2460 \uE06D \uE036\uE03D
      \uE034 \u2461 \uE06D \uE034\uE038 \uE034 \u2462 \uE06D \uE034\uE03D \uE034
      \u2463 \uE06D \uE034\uE038 \uE035 \u2464 \uE06D\uE036 \uE034 11. \uB2E4\uC74C\uC740
      \uC6D0\uC18C X, Y\uC640 \uAD00\uB828\uB41C \uC0B0\uD654 \uD658\uC6D0 \uBC18\uC751
      \uC2E4\uD5D8\uC774\uB2E4.  [\uC790\uB8CC] \u25E6\uD654\uD559 \uBC18\uC751\uC2DD:
      \uE0E5XO\uE037 \uE035\uE046\uE048\uE0E6Y\uE046\uE048\uE0E7H \uE048\u2192\uE0E5X\uE0F1\uE048\uE048\uE0E8Y\uE035\uE048\uE0E9H\uE035O
      (\uE0E5\uFF5E\uE0E9\uB294 \uBC18\uC751 \uACC4\uC218) \u25E6X\uC758 \uC0B0\uD654\uBB3C\uC5D0\uC11C
      \uC0B0\uC18C(O)\uC758 \uC0B0\uD654\uC218\uB294 \uE046\uE035\uC774\uB2E4. [\uC2E4\uD5D8
      \uACFC\uC815 \uBC0F \uACB0\uACFC] \u25E6XO\uE037 \uE035\uE046 \uE035\uE00Dmol\uC744
      \uCDA9\uBD84\uD55C \uC591\uC758 Y\uE046\uACFC H \uE048\uC774 \uB4E4\uC5B4 \uC788\uB294
      \uC218\uC6A9\uC561\uC5D0  \uB123\uC5B4 \uBAA8\uB450 \uBC18\uC751\uC2DC\uCF30\uB354\uB2C8,
      Y\uE035 \uE036\uE00Dmol\uC774 \uC0DD\uC131\uB418\uC5C8\uB2E4. \uE0F1\xD7\uE06D\uE0E7
      \uE0E5\uB294? (\uB2E8, X\uC640 Y\uB294 \uC784\uC758\uC758 \uC6D0\uC18C \uAE30\uD638\uC774\uACE0,
      Y\uE035\uB294 \uBB3C\uACFC  \uBC18\uC751\uD558\uC9C0 \uC54A\uB294\uB2E4.) \u2460
      \uE06D\uE03B \uE034 \u2461 \uE06D\uE037 \uE034 \u2462 \uE06D\uE03B \uE036 \u2463
      \uE06D\uE035 \uE034 \u2464 \uE06D\uE037 \uE036 12. \uADF8\uB9BC\uC740 \uC6D0\uC790
      A\uFF5ED\uC758 \uC911\uC131\uC790\uC218(\uE0E5)\uC640  \uC804\uC790 \uC218(\uE0E6)\uC758
      \uCC28(\uE0E5\uE046\uE0E6)\uC640 \uC9C8\uB7C9\uC218\uB97C \uB098\uD0C0\uB0B8 
      \uAC83\uC774\uB2E4. A\uFF5ED\uB294 \uC6D0\uC18C X\uC758 \uB3D9\uC704 \uC6D0\uC18C\uC774\uACE0, 
      A\uFF5ED\uC758 \uC911\uC131\uC790\uC218 \uD569\uC740 \uE03C\uE039\uC774\uB2E4.
      \uE034g\uC758 A\uC5D0 \uB4E4\uC5B4 \uC788\uB294 \uC911\uC131\uC790\uC218 \uE034g\uC758
      D\uC5D0 \uB4E4\uC5B4 \uC788\uB294 \uC911\uC131\uC790\uC218\uB294?"
