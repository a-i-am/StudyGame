      \uD654\uD559  \uBC18\uC751\uC2DD\uACFC \uBC18\uC751 \uC18D\uB3C4\uC2DD\uC774\uB2E4.
      \uE0EF\uB294 \uBC18\uC751 \uC18D\uB3C4 \uC0C1\uC218\uC774\uB2E4. \uE035A(g)
      \u2192\uE035B(g) \uE048C(g)   \uE0FA\uE047\uE0EF\uE049A\uE04A \uADF8\uB9BC\uC740
      \uC628\uB3C4 \uE013\uC5D0\uC11C \uAC15\uCCA0 \uC6A9\uAE30\uC5D0 A(g)\uC640
