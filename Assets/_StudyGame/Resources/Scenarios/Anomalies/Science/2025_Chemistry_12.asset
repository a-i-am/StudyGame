      \uC804\uCCB4 \uC555\uB825\uC758 \uE06D \uE034\uE036 \uE035\uBC30\uC774\uB2E4.
      \uBC18\uC751 \uC2DC\uAC04\uC774 \uE035\uE0F8\uC77C \uB54C, He(g)\uC758 \uC591(mol)
