      \uC874\uC7AC\uD558\uBA70, \uC81C\uC2DC\uB41C  \uC870\uAC74 \uC774\uC678\uC758
      \uB2E4\uB978 \uC870\uAC74\uC740 \uB3D9\uC77C\uD558\uB2E4.) <\uBCF4 \uAE30>
      \u3131. \u3260\uC740 RuBP\uC774\uB2E4. \u3134. (\uAC00)\uB294 \u2018\uBE5B
