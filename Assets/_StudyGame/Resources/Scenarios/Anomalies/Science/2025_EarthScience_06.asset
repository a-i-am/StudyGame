  NodeTitle: "[Science] 6. \uADF8\uB9BC (\uAC00)\uB294 \uC5B4\uB290 \uB0A0 \uE035\uE034\uC2DC\uC758
    \uC9C0\uC0C1 \uC77C..."
  TemplateType: "\uAE30\uBBF9 (Anomaly)"
  ThemeColorHex: '#33CC33'
