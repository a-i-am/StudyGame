      11. \uB2E4\uC74C\uC740 CO\uE035\uC758 \uC0C1\uD3C9\uD615\uACFC \uAD00\uB828\uB41C
      \uC2E4\uD5D8\uC774\uB2E4. [\uC790\uB8CC] \u25E6CO\uE035\uC758 \uC0C1\uD3C9\uD615
      \uADF8\uB9BC [\uC2E4\uD5D8 \uACFC\uC815] (\uAC00) \uADF8\uB9BC\uC740 \uAF2D\uC9C0\uB85C
      \uBD84\uB9AC\uB41C \uC9C4\uACF5 \uAC15\uCCA0  \uC6A9\uAE30\uC5D0 CO\uE035(\uE0F7)\uB97C
      \uB123\uC740 \uCD08\uAE30 \uC0C1\uD0DC\uB97C  \uB098\uD0C0\uB0B8 \uAC83\uC774\uB2E4. 
      \uE0F8\u2103\uC5D0\uC11C \uD3C9\uD615\uC5D0  \uB3C4\uB2EC\uD55C \uD6C4 CO\uE035\uAC00
      \uB4E4\uC5B4 \uC788\uB294 \uC6A9\uAE30 \uC18D \uC555\uB825\uC744 \uCE21\uC815\uD558\uACE0, 
      CO\uE035\uC758 \uC548\uC815\uD55C \uC0C1\uC744 \uAD00\uCC30\uD55C\uB2E4. (\uB098)
      \uAF2D\uC9C0\uB97C \uC5F4\uACE0, \uE0F8\u2103\uC5D0\uC11C \uD3C9\uD615\uC5D0
      \uB3C4\uB2EC\uD55C \uD6C4 \uC6A9\uAE30 \uC18D \uC555\uB825\uC744  \uCE21\uC815\uD558\uACE0,
      CO\uE035\uC758 \uC548\uC815\uD55C \uC0C1\uC744 \uAD00\uCC30\uD55C\uB2E4. [\uC2E4\uD5D8
      \uACB0\uACFC] \u25E6(\uAC00)\uC758 \uD3C9\uD615 \uC0C1\uD0DC\uC5D0\uC11C \uC6A9\uAE30
      \uC18D \uC628\uB3C4\uC640 \uC555\uB825\uC740 \uE0F8\u2103, \uE00F\uE034atm
      \uC774\uACE0, CO\uE035\uC758 \uC548\uC815\uD55C \uC0C1\uC740 \uAE30\uCCB4\uC640
      \uC561\uCCB4\uC774\uB2E4. \u25E6(\uB098)\uC758 \uD3C9\uD615 \uC0C1\uD0DC\uC5D0\uC11C
      \uC6A9\uAE30 \uC18D \uC628\uB3C4\uC640 \uC555\uB825\uC740 \uE0F8\u2103, \uE00F\uE035atm
      \uC774\uACE0, CO\uE035\uC758 \uC548\uC815\uD55C \uC0C1\uC758 \uC218\uB294 \uE035\uC774\uB2E4.
      \uB2E4\uC74C \uC911 \uE0F8\uC758 \uD06C\uAE30( \u3260)\uC640, \uE00F\uE034\uACFC
