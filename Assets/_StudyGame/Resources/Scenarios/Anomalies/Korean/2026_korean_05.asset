  NodeTitle: "[Korean] 5. (\uAC00)\uB97C \uD1B5\uD574 \uC54C \uC218 \uC788\uB294
    \uB0B4\uC6A9\uC73C\uB85C \uC801\uC808..."
  TemplateType: "\uAE30\uBBF9 (Anomaly)"
  ThemeColorHex: '#FF3366'
