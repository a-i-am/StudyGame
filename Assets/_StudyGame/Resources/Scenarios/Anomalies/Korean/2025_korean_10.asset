  NodeTitle: "[Korean] 10. \uD559\uC0DD\uC774 \uC717\uAE00\uC744 \uC77D\uC740 \uBC29\uBC95\uC73C\uB85C
    \uC801\uC808\uD558\uC9C0 ..."
  TemplateType: "\uAE30\uBBF9 (Anomaly)"
  ThemeColorHex: '#FF3366'
