  NodeTitle: "[Korean] 39. \uB300\uD654\uC758 \uD750\uB984\uC744 \uACE0\uB824\uD560
    \uB54C, \u3260\uFF5E\u3264\uC5D0 \uB300..."
  TemplateType: "\uAE30\uBBF9 (Anomaly)"
  ThemeColorHex: '#FF3366'
