  Properties:
  - PropertyName: Original Formula
    Type: 0
    StringValue: "43. \uB2E4\uC74C\uC740 \uD559\uC0DD\uC774 \uCD08\uACE0\uB97C \uC791\uC131\uD560
      \uB54C \uB5A0\uC62C\uB9B0 \uC0DD\uAC01\uC774\uB2E4. \uC774\uB97C \uACE0\uB824\uD560 
      \uB54C [A]\uC5D0 \uB4E4\uC5B4\uAC08 \uB0B4\uC6A9\uC73C\uB85C \uAC00\uC7A5 \uC801\uC808\uD55C
      \uAC83\uC740? \uB9C8\uC9C0\uB9C9 \uBB38\uB2E8\uC5D0\uC11C\uB294 \uAE00\uC758
      \uC804\uCCB4\uC801\uC778 \uD750\uB984\uC744 \uACE0\uB824\uD558\uC5EC, \uC644\uBCBD
      \uC8FC\uC758\uC801 \uC790\uAE30 \uC81C\uC2DC \uC131\uD5A5\uC73C\uB85C \uC778\uD574
      \uACAA\uC744 \uC218 \uC788\uB294 \uC815\uC11C\uC801 \uC5B4\uB824 \uC6C0\uC744
      \uBA85\uC2DC\uD558\uACE0, \uC774\uB97C \uC644\uD654\uD558\uB294 \uB370 \uB3C4\uC6C0\uC774
      \uB418\uB294 \uD0DC\uB3C4\uC640 \uADF8\uAC83\uC774  \uAC00\uC838\uC62C \uAE0D\uC815\uC801
      \uBCC0\uD654\uB97C \uC81C\uC2DC\uD574\uC57C\uACA0\uC5B4. \u2460\uC790\uC2E0\uC5D0
      \uB300\uD55C \uAE0D\uC815\uC801 \uD3C9\uAC00\uAC00 \uC9C4\uC2EC\uC73C\uB85C
      \uB290\uAEF4\uC9C0\uC9C0 \uC54A\uC544 \uBD88\uC548\uD574\uC9C8  \uB54C, \uC774\uB97C
      \uADF8\uB300\uB85C \uB454\uB2E4\uBA74 \uC644\uBCBD\uC8FC\uC758\uC801 \uC790\uAE30
      \uC81C\uC2DC \uC131\uD5A5\uC774 \uACE0\uCC29\uD654\uB420  \uAC83\uC774\uB2E4.
      \u2461\uD0C0\uC778\uC758 \uC2DC\uC120\uC744 \uACE0\uB824\uD558\uAE30\uBCF4\uB2E4
      \uC790\uC2E0\uC758 \uC2DC\uC57C\uC5D0\uB9CC \uAC07\uD600 \uBD88\uC548\uD55C 
      \uB9C8\uC74C\uC774 \uB4E0\uB2E4\uBA74, \uC77C\uC0C1\uC5D0\uC11C \uAC77\uAE30\uC640
      \uAC19\uC740 \uC2E0\uCCB4 \uD65C\uB3D9\uC744 \uD574 \uBCF4\uB294  \uAC83\uC774
      \uC5B4\uB5A8\uAE4C? \u2462\uD0C0\uC778\uC5D0\uAC8C \uC644\uBCBD\uD55C \uBAA8\uC2B5\uC744
      \uBCF4\uC774\uACE0 \uC2F6\uC740 \uB9C8\uC74C\uC774 \uBD88\uC548\uC73C\uB85C
      \uC774\uC5B4\uC9C8  \uB54C, \uC790\uAE30 \uC790\uC2E0\uC744 \uC788\uB294 \uADF8\uB300\uB85C
      \uBC1B\uC544\uB4E4\uC778\uB2E4\uBA74 \uC2EC\uB9AC\uC801 \uC548\uC815\uC744 
      \uC5BB\uC744 \uC218 \uC788\uC744 \uAC83\uC774\uB2E4. \u2463\uC644\uBCBD\uC8FC\uC758\uC801
      \uC790\uAE30 \uC81C\uC2DC \uC131\uD5A5\uC740 \uC0AC\uD68C\uC0DD\uD65C\uC744
      \uD558\uB294 \uB370 \uC5EC\uB7EC \uAC00\uC9C0  \uBB38\uC81C\uB97C \uCD08\uB798\uD558\uBBC0\uB85C,
      \uAC1D\uAD00\uC801\uC73C\uB85C \uC0C1\uD669\uC744 \uBC14\uB77C\uBCF4\uB294
      \uC778\uC9C0\uC801 \uC720\uC5F0 \uC131\uC744 \uBC1C\uD718\uD574 \uBCF4\uB294
      \uAC83\uC774 \uC5B4\uB5A8\uAE4C? \u2464\uC644\uBCBD\uD568\uC744 \uCD94\uAD6C\uD558\uB294
      \uAC83\uC740 \uACE0\uD1B5\uC744 \uC218\uBC18\uD560 \uC218 \uC788\uC73C\uBBC0\uB85C,
      \uBB34\uC870\uAC74\uC801  \uC790\uAE30 \uC218\uC6A9\uBCF4\uB2E4\uB294 \uC0AC\uD68C\uC801
      \uC9C0\uC9C0 \uCD94\uAD6C \uD589\uB3D9\uC744 \uD1B5\uD574 \uC2A4\uC2A4\uB85C\uC758 
      \uB9C8\uC74C\uC744 \uB2E4\uC2A4\uB9B0\uB2E4\uBA74 \uB9C8\uC74C\uC774 \uD3B8\uC548\uD574\uC9C8
      \uC218 \uC788\uC744 \uAC83\uC774\uB2E4. 44. \uCD08\uACE0\uC5D0 \uBC18\uC601\uB41C
      \uAE00\uC4F0\uAE30 \uACC4\uD68D\uC73C\uB85C \uC801\uC808\uD558\uC9C0 \uC54A\uC740
      \uAC83\uC740? \u2460\uC644\uBCBD\uC8FC\uC758\uC801 \uC790\uAE30 \uC81C\uC2DC
      \uC131\uD5A5\uC758 \uAC1C\uB150\uC744 \uBC1D\uD600\uC57C\uACA0\uC5B4. \u2461\uC644\uBCBD\uC8FC\uC758\uC801
      \uC790\uAE30 \uC81C\uC2DC \uC131\uD5A5\uC758 \uC7A5\uB2E8\uC810\uC744 \uC124\uBA85\uD574\uC57C\uACA0\uC5B4.
      \u2462\uC0AC\uB78C\uB4E4\uC758 \uC77C\uBC18\uC801\uC778 \uD2B9\uC131\uC744
      \uC81C\uC2DC\uD558\uBA70 \uAE00\uC744 \uC2DC\uC791\uD574\uC57C\uACA0\uC5B4.
      \u2463\uC644\uBCBD\uC8FC\uC758\uC801 \uC790\uAE30 \uC81C\uC2DC \uC131\uD5A5\uC774
      \uB192\uC740 \uC0AC\uB78C\uC758 \uD2B9\uC9D5\uC744 \uC5B8\uAE09\uD574\uC57C\uACA0\uC5B4.
      \u2464\uD2B9\uC815 \uC2DC\uAE30\uC5D0 \uC644\uBCBD\uC8FC\uC758\uC801 \uC790\uAE30
      \uC81C\uC2DC \uC131\uD5A5\uC774 \uB098\uD0C0\uB098\uB294 \uACBD\uC6B0\uAC00 
      \uB9CE\uC740 \uC774\uC720\uB97C \uC81C\uC2DC\uD574\uC57C\uACA0\uC5B4. 45. <\uBCF4\uAE30>\uB294
      \uD559\uC0DD\uC774 \uCD08\uACE0\uB97C \uBCF4\uC644\uD558\uAE30 \uC704\uD574
      \uCD94\uAC00\uB85C \uC218\uC9D1\uD55C \uC790\uB8CC \uC774\uB2E4. \uC790\uB8CC\uC758
      \uD65C\uC6A9 \uBC29\uC548\uC73C\uB85C \uC801\uC808\uD558\uC9C0 \uC54A\uC740
      \uAC83\uC740?"
