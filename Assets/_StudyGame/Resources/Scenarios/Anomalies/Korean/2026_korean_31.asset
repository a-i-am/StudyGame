  NodeTitle: "[Korean] 31. (\uAC00), (\uB098)\uC5D0 \uB300\uD55C \uC124\uBA85\uC73C\uB85C
    \uAC00\uC7A5 ..."
  TemplateType: "\uAE30\uBBF9 (Anomaly)"
  ThemeColorHex: '#FF3366'
