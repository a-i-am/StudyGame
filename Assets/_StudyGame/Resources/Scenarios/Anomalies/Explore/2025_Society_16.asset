  Properties:
  - PropertyName: Original Formula
    Type: 0
    StringValue: "16. \uBBFC\uBC95\uC758 \uAE30\uBCF8 \uC6D0\uCE59 A\uC5D0 \uB300\uD55C
      \uC124\uBA85\uC73C\uB85C \uC633\uC740 \uAC83\uC740? \u2460A\uB294\uAC1C\uC778\uC758
      \uC790\uC720\uB85C\uC6B4 \uC758\uC0AC\uC5D0 \uB530\uB77C \uD615\uC131\uB41C
      \uACC4\uC57D \uAD00\uACC4\uC5D0 \uAD6D\uAC00\uB098  \uD0C0\uC778\uC774 \uAC1C\uC785\uD574\uC11C\uB294
      \uC548 \uB41C\uB2E4\uB294 \uC6D0\uCE59\uC774\uB2E4. \u2461A\uB294 \uB2E4\uB978
      \uC0AC\uB78C\uC5D0\uAC8C \uC190\uD574\uB97C \uC785\uD78C \uD589\uC704\uC5D0
      \uB300\uD574 \uACE0\uC758\uB098 \uACFC\uC2E4\uC774 \uC5C6\uB294  \uACBD\uC6B0\uC5D0\uB294
      \uCC45\uC784\uC744 \uC9C0\uC9C0 \uC54A\uB294\uB2E4\uB294 \uC6D0\uCE59\uC774\uB2E4.
      \u2462A\uB294\uAC1C\uC778\uC740 \uC790\uC2E0\uC774 \uC18C\uC720\uD558\uB294
      \uC7AC\uC0B0\uC744 \uBC30\uD0C0\uC801\uC73C\uB85C \uC0AC\uC6A9\u2024\uC218\uC775 
      \uB610\uB294 \uCC98\uBD84\uD560 \uC218 \uC788\uB294 \uAD8C\uB9AC\uB97C \uAC16\uB294\uB2E4\uB294
      \uC6D0\uCE59\uC774\uB2E4. \u2463\uACC4\uC57D \uB0B4\uC6A9\uC774 \uD55C\uCABD
      \uB2F9\uC0AC\uC790\uC5D0\uAC8C \uD604\uC800\uD558\uAC8C \uBD88\uACF5\uC815\uD55C
      \uACBD\uC6B0 \uADF8\uB7EC\uD55C  \uACC4\uC57D\uC758 \uB0B4\uC6A9\uC740 \uBB34\uD6A8\uB77C\uB294
      \uBC95\uB960\uC758 \uADDC\uC815\uC740 A\uC5D0 \uADFC\uAC70\uD55C\uB2E4. \u2464\uD658\uACBD
      \uC624\uC5FC\uC73C\uB85C \uD53C\uD574\uAC00 \uBC1C\uC0DD\uD55C \uACBD\uC6B0
      \uD574\uB2F9 \uD658\uACBD \uC624\uC5FC\uC758 \uC6D0\uC778\uC790\uAC00  \uADF8
      \uD53C\uD574\uB97C \uBC30\uC0C1\uD558\uC5EC\uC57C \uD55C\uB2E4\uB294 \uBC95\uB960\uC758
      \uADDC\uC815\uC740 A\uC5D0 \uADFC\uAC70\uD55C\uB2E4. 17. \uB2E4\uC74C \uC0AC\uB840\uC5D0
      \uB300\uD55C \uBC95\uC801 \uD310\uB2E8\uC73C\uB85C \uC633\uC740 \uAC83\uC740?
      [3\uC810] \uD3C9\uC18C\uC5D0 \uC7A5\uB09C\uC774 \uC2EC\uD55C \uAC11(18\uC138)\uC740
      \uCE5C\uAD6C \uC744(18\uC138)\uC758 \uD734\uB300 \uC804\uD654\uB97C \uC2E4\uC218\uB85C 
      \uAE68\uB728\uB838\uB2E4. \uADF8\uB0A0 \uC800\uB141 \uAC11\uC740 \uBD80\uBAA8\uC758
      \uD5C8\uB77D\uC744 \uBC1B\uC544 \uC790\uC2E0\uC774 \uD0A4\uC6B0\uB358 \uAC1C\uB97C
      \uB370\uB9AC\uACE0  \uC0B0\uCC45\uD558\uB358 \uC911 \uC744\uC744 \uB9CC\uB0AC\uB2E4.
      \uAC11\uC740 \uC7A5\uB09C\uC0BC\uC544 \uC790\uC2E0\uC758 \uAC1C\uC5D0\uAC8C
      \uC744\uC744 \uD5A5\uD558\uC5EC   \u201C\uBB3C\uC5B4!\u201D\uB77C\uACE0 \uBA85\uB839\uD558\uC600\uACE0,
      \uBAA9\uC904\uC774 \uD480\uB9B0 \uAC11\uC758 \uAC1C\uAC00 \uC744\uC744 \uBB3C\uC5B4
      \uC744\uC5D0\uAC8C \uC0C1\uD574\uB97C  \uC785\uD614\uB2E4. \uC744\uC758 \uC704\uAE09\uD55C
      \uC0C1\uD669\uC744 \uBAA9\uACA9\uD55C \uBCD1\uC740 \uC744\uC744 \uAD6C\uD558\uAE30
      \uC704\uD574 \uAC11\uC758 \uAC1C\uB97C  \uBC1C\uB85C \uCC3C\uB2E4. \uB3D9\uBB3C
      \uD559\uB300 \uD610\uC758\uB85C \uC218\uC0AC\uB97C \uBC1B\uC740 \uBCD1\uC5D0
      \uB300\uD574 \uAC80\uC0AC\uB294 \uC815\uB2F9\uBC29\uC704\uB97C  \uC774\uC720\uB85C
      \uBD88\uAE30\uC18C \uCC98\uBD84\uC744 \uD558\uC600\uB2E4. \uD734\uB300 \uC804\uD654
      \uC190\uAD34 \uBC0F \uC0C1\uD574 \uD610\uC758\uB85C \uBD88\uAD6C\uC18D  \uC0C1\uD0DC\uC5D0\uC11C
      \uC218\uC0AC\uB97C \uBC1B\uC740 \uAC11\uC5D0 \uB300\uD574 \uAC80\uC0AC\uB294
      \uACFC\uC2E4\uC5D0 \uC758\uD55C \uC190\uAD34\uB294 \uBC95 \uADDC\uC815\uC774
      \uC5C6\uC5B4  \uBC94\uC8C4\uAC00 \uC131\uB9BD\uD558\uC9C0 \uC54A\uB294\uB2E4\uACE0
      \uBD88\uAE30\uC18C \uCC98\uBD84\uC744 \uD558\uC600\uACE0, \uC0C1\uD574 \uD610\uC758\uC5D0
      \uB300\uD574\uC11C\uB294  \uC815\uC0C1\uC744 \uCC38\uC791\uD558\uC5EC \uAE30\uC18C
      \uC720\uC608 \uCC98\uBD84\uC744 \uD558\uC600\uB2E4. \u2460\uAC11\uC5D0\uAC8C
      \uCC45\uC784 \uB2A5\uB825\uC774 \uC778\uC815\uB418\uB354\uB77C\uB3C4 \uAC11\uC758
      \uBD80\uBAA8\uB294 \uC744\uC758 \uC0C1\uD574\uC5D0 \uB300\uD574  \uBC95\uC815
      \uAC10\uB3C5 \uC758\uBB34\uC790\uB85C\uC11C \uD2B9\uC218 \uBD88\uBC95 \uD589\uC704
      \uCC45\uC784\uC744 \uC9C4\uB2E4. \u2461\uC744\uC740 \uBC30\uC0C1 \uBA85\uB839
      \uC81C\uB3C4\uB97C \uD1B5\uD558\uC5EC \uAC11\uC5D0\uAC8C \uC190\uD574\uB97C
      \uBC30\uC0C1\uBC1B\uC744 \uC218 \uC788\uB2E4. \u2462\uAC80\uC0AC\uB294\uAC11\uC774
      \uC744\uC758 \uD734\uB300 \uC804\uD654\uB97C \uC190\uAD34\uD55C \uD589\uC704\uC5D0
      \uB300\uD558\uC5EC \uAD6C\uC131 \uC694\uAC74\uC5D0  \uD574\uB2F9\uD558\uC9C0
      \uC54A\uB294 \uAC83\uC73C\uB85C \uD310\uB2E8\uD558\uC600\uB2E4. \u2463\uAC80\uC0AC\uB294
      \uAC11\uC758 \uC0C1\uD574 \uD610\uC758\uC5D0 \uB300\uD558\uC5EC \uAC1D\uAD00\uC801
      \uBC95\uC9C8\uC11C \uAD00\uC810\uC5D0\uC11C \uC704\uBC30 \uB418\uC9C0\uB9CC,
      \uBC95\uC801 \uBE44\uB09C \uAC00\uB2A5\uC131\uC774 \uC5C6\uB294 \uAC83\uC73C\uB85C
      \uD310\uB2E8\uD558\uC600\uB2E4. \u2464\uAC80\uC0AC\uB294 \uBCD1\uC758 \uD589\uC704\uC5D0
      \uB300\uD558\uC5EC \uD0C0\uC778\uC758 \uBC95\uC775\uC5D0 \uB300\uD55C \uD604\uC7AC\uC758
      \uC704\uB09C\uC744  \uD53C\uD558\uAE30 \uC704\uD55C \uD589\uC704\uB85C \uC0C1\uB2F9\uD55C
      \uC774\uC720\uAC00 \uC788\uB2E4\uACE0 \uD310\uB2E8\uD558\uC600\uB2E4. 18. \uAD6D\uC81C
      \uC5F0\uD569\uC758 \uC8FC\uC694 \uAE30\uAD00 A\uFF5EC\uC5D0 \uB300\uD55C \uC124\uBA85\uC73C\uB85C
      \uC633\uC740 \uAC83\uC740? \u2460A\uB97C \uAD6C\uC131\uD558\uB294 15\uAC1C
      \uC774\uC0AC\uAD6D\uC758 \uC784\uAE30\uB294 \uB3D9\uC77C\uD558\uB2E4. \u2461A\uC5D0\uC11C
      \uC808\uCC28 \uC0AC\uD56D\uC744 \uD3EC\uD568\uD55C \uBAA8\uB4E0 \uC0AC\uD56D\uC5D0
      \uB300\uD55C \uACB0\uC815\uC740 \uC0C1\uC784 \uC774\uC0AC\uAD6D  \uC804\uCCB4\uC758
      \uB3D9\uC758\uB97C \uC804\uC81C\uB85C \uD55C\uB2E4. \u2462B\uC758 \uACB0\uC758\uC548\uC740
      \uD68C\uC6D0\uAD6D\uC758 \uC758\uC9C0\uAC00 \uBC18\uC601\uB418\uC5B4 \uAC15\uC81C\uB825\uC774
      \uC788\uB2E4. \u2463C\uAC00 \uAD00\uD560\uD558\uB294 \uBC95\uC801 \uBD84\uC7C1\uC5D0\uB294
      \uAD6D\uAC00\uBFD0\uB9CC \uC544\uB2C8\uB77C \uAC1C\uC778\uB3C4 \uC18C\uC1A1 
      \uB2F9\uC0AC\uC790\uAC00 \uB420 \uC218 \uC788\uB2E4. \u2464C\uB97C \uAD6C\uC131\uD558\uB294
      15\uC778\uC758 \uC7AC\uD310\uAD00\uC5D0 \uB300\uD55C \uC120\uCD9C \uAD8C\uD55C\uC740
      A\uC640 B\uAC00 \uAC00\uC9C4\uB2E4. 19. \uAD6D\uC81C \uAD00\uACC4\uB97C \uBC14\uB77C\uBCF4\uB294
      \uAD00\uC810 A, B\uC5D0 \uB300\uD55C \uC124\uBA85\uC73C\uB85C \uC633\uC740
      \uAC83\uC740? \uAD6D\uC81C \uC815\uCE58 \uBD84\uC11D\uC758 \uD575\uC2EC \uB2E8\uC704\uB97C
      \uC8FC\uAD8C \uAD6D\uAC00\uC5D0 \uB450\uACE0 \uC788\uB294 A\uB294 \uAD6D\uC81C
      \uC0AC\uD68C\uC5D0\uC11C  \uAC1C\uBCC4 \uAD6D\uAC00\uC758 \uCD5C\uC6B0\uC120
      \uBAA9\uD45C\uAC00 \uC790\uAD6D \uC774\uC775 \uADF9\uB300\uD654\uC5D0 \uC788\uACE0,
      \uAD6D\uC81C\uAE30\uAD6C\uB294 \uC8FC\uAD8C  \uAD6D\uAC00\uC758 \uD589\uC704\uB97C
      \uC5B5\uC81C\uD560 \uC218 \uC5C6\uB2E4\uACE0 \uBCF8\uB2E4. \uBC18\uBA74 \uAD6D\uC81C
      \uAD00\uACC4\uB97C \uC778\uAC04\uC758 \uC774\uC131\uACFC  \uB3C4\uB355\uC774
      \uC791\uB3D9\uD558\uB294 \uC0AC\uD68C\uB85C \uD30C\uC545\uD558\uB294 B\uB294
      \uAD6D\uC81C\uAE30\uAD6C\uAC00 \uAD6D\uAC00 \uAC04 \uAC08\uB4F1\uC758 \uC704\uD5D8\uC131\uC744 
      \uB0AE\uCD94\uACE0 \uD3C9\uD654\uC801\uC774\uACE0 \uD611\uB825\uC801\uC778
      \uAD6D\uC81C \uC0AC\uD68C \uD615\uC131\uC5D0 \uAC74\uC124\uC801\uC778 \uC5ED\uD560\uC744
      \uD55C\uB2E4\uACE0 \uBCF8\uB2E4. \u2460A\uB294\uAD6D\uAC00 \uAC04 \uACBD\uC7C1\uBCF4\uB2E4
      \uC0C1\uD638 \uC758\uC874\uC801 \uAD00\uACC4\uB97C \uC911\uC2DC\uD55C\uB2E4.
      \u2461B\uB294\uD798\uC758 \uB17C\uB9AC\uAC00 \uC9C0\uBC30\uD558\uB294 \uAD6D\uC81C
      \uC0AC\uD68C\uC758 \uD604\uC2E4\uC744 \uAC15\uC870\uD55C\uB2E4. \u2462A\uC640
      \uB2EC\uB9AC B\uB294 \uAC1C\uBCC4 \uAD6D\uAC00\uC758 \uC774\uC775\uACFC \uAD6D\uC81C
      \uC0AC\uD68C \uC804\uCCB4\uC758 \uC774\uC775\uC774 \uC870\uD654\uB97C  \uC774\uB8F0
      \uC218 \uC788\uB2E4\uACE0 \uBCF8\uB2E4. \u2463B\uC640 \uB2EC\uB9AC A\uB294
      \uD2B9\uC815 \uAD6D\uAC00\uC758 \uCE68\uB7B5 \uD589\uC704\uC5D0 \uBAA8\uB4E0
      \uAD6D\uAC00\uB4E4\uC774 \uACF5\uB3D9\uC73C\uB85C  \uB300\uC751\uD568\uC73C\uB85C\uC368
      \uAD6D\uC81C \uBD84\uC7C1\uC774 \uD574\uACB0\uB420 \uC218 \uC788\uB2E4\uACE0
      \uBCF8\uB2E4. \u2464A\uC640 B \uBAA8\uB450 \uAD6D\uC81C \uC0AC\uD68C\uC758
      \uC77C\uBC18\uC801 \uAD00\uD589\uACFC \uBC95\uC801 \uD655\uC2E0\uC5D0 \uAE30\uCD08\uD55C 
      \uAD6D\uC81C \uADDC\uBC94\uC744 \uD1B5\uD574 \uAD6D\uC81C \uC0AC\uD68C\uC758
      \uBB34\uC815\uBD80 \uC0C1\uD0DC\uB97C \uADF9\uBCF5\uD560 \uC218 \uC788\uB2E4\uACE0
      \uBCF8\uB2E4. 20. (\uAC00)\uC5D0 \uB4E4\uC5B4\uAC08 \uC218 \uC788\uB294 \uC633\uC740
      \uB0B4\uC6A9\uB9CC\uC744 <\uBCF4\uAE30>\uC5D0\uC11C \uC788\uB294 \uB300\uB85C 
      \uACE0\uB978 \uAC83\uC740?"
