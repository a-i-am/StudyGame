  NodeTitle: "[Explore] 16. \uBBFC\uBC95\uC758 \uAE30\uBCF8 \uC6D0\uCE59 A\uC5D0
    \uB300\uD55C \uC124\uBA85\uC73C\uB85C ..."
  TemplateType: "\uAE30\uBBF9 (Anomaly)"
