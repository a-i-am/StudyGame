        interaction_node:
          node_type: EntityRuneNode
          trigger_event: OnPlayerDecipher
          required_solution: 1
      - id: 2023_math_calc_29
        law_id: law_series_sum
        question_text: "\uC138 \uC0C1\uC218 a, b, c\uC5D0 \uB300\uD558\uC5EC \uD568\uC218
          f(x) = ae^{2x} + be^x + c\uAC00 \uB2E4\uC74C \uC870\uAC74\uC744 \uB9CC\uC871\uC2DC\uD0A8\uB2E4.\\n(\uAC00)
          \\lim_{x \\to -\\infty} \\frac{f(x)+6}{e^x} = 1\\n(\uB098) f(\\ln 2) =
          0\\n\uD568\uC218 f(x)\uC758 \uC5ED\uD568\uC218\uB97C g(x)\uB77C \uD560
          \uB54C, \uB2E4\uC74C \uC815\uC801\uBD84\uC758 \uAC12\uC774 p + q \\ln 2\uC774\uB2E4.
          p+q\uC758 \uAC12\uC744 \uAD6C\uD558\uC2DC\uC624. (\uB2E8, p, q\uB294 \uC720\uB9AC\uC218\uC774\uACE0,
          \\ln 2\uB294 \uBB34\uB9AC\uC218\uC774\uB2E4.)"
        formula: \int_{0}^{14} g(x) dx = p + q \ln 2
        choices: []
