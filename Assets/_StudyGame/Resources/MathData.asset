        question_text: "\uCD5C\uACE0\uCC28\uD56D\uC758 \uACC4\uC218\uAC00 \uC591\uC218\uC778
          \uC0BC\uCC28\uD568\uC218 f(x)\uC640 \uD568\uC218 g(x) = e^{\\sin \\pi x}
