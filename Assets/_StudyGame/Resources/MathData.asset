          \uB9CC\uC871\uC2DC\uD0A8\uB2E4.\n(\uAC00) 0 \\le t \\le 2\uC77C \uB54C,
          v(t) = 2t^3 - 8t\uC774\uB2E4.\n(\uB098) t \\ge 2\uC77C \uB54C, a(t) = 6t
