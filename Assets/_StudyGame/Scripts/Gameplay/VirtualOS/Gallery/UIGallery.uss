.gallery-root {
    width: 100%;
    height: 100%;
    background-color: #ECEEF2;
    flex-direction: column;
    padding: 24px;
}

.gallery-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 20px;
    margin-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: #D0D5DD;
}

.gallery-title-box {
    flex-direction: column;
}

.gallery-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: #1D2939;
    margin-bottom: 4px;
}

.gallery-subtitle {
    font-size: 14px;
    color: #667085;
}

.gallery-count-badge {
    background-color: #4B5563;
    color: #FFFFFF;
    font-size: 13px;
    -unity-font-style: bold;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-radius: 16px;
}

.gallery-scroll {
    flex-grow: 1;
    width: 100%;
}

.gallery-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    padding-top: 10px;
    padding-bottom: 30px;
}

.window-card {
    width: 31.8%;
    min-height: 240px;
    background-color: #FFFFFF;
    border-radius: 12px;
    border-width: 1px;
    border-color: #E4E7EC;
    margin-bottom: 24px;
    overflow: hidden;
    transition-property: all;
    transition-duration: 0.15s;
}

.window-card:hover {
    border-color: #6366F1;
    translate: 0 -4px;
}

.window-card-header {
    height: 38px;
    background-color: #F8F9FA;
    border-bottom-width: 1px;
    border-bottom-color: #EAECF0;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
}

.window-dots {
    flex-direction: row;
    align-items: center;
    margin-right: 10px;
}

.dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 6px;
}

.dot-red {
    background-color: #FF5F56;
}

.dot-yellow {
    background-color: #FFBD2E;
}

.dot-green {
    background-color: #27C93F;
}

.window-nav {
    flex-direction: row;
    align-items: center;
    margin-right: 10px;
}

.window-nav-text {
    font-size: 11px;
    color: #98A2B3;
    margin-right: 6px;
}

.window-address-bar {
    flex-grow: 1;
    height: 24px;
    background-color: #FFFFFF;
    border-radius: 6px;
    border-width: 1px;
    border-color: #D0D5DD;
    justify-content: center;
    padding-left: 8px;
    padding-right: 8px;
}

.window-address-text {
    font-size: 11px;
    color: #475467;
    overflow: hidden;
    text-overflow: ellipsis;
}

.window-card-body {
    flex-grow: 1;
    padding: 16px;
    flex-direction: column;
    justify-content: space-between;
}

.wireframe-preview {
    height: 110px;
    background-color: #F2F4F7;
    border-radius: 8px;
    border-width: 1px;
    border-color: #EAECF0;
    justify-content: center;
    align-items: center;
    margin-bottom: 14px;
    padding: 12px;
}

.wireframe-box-row {
    flex-direction: row;
    width: 100%;
    margin-bottom: 6px;
}

.wireframe-box {
    background-color: #D0D5DD;
    border-radius: 4px;
    height: 12px;
    flex-grow: 1;
    margin-right: 4px;
}

.wireframe-box-square {
    width: 36px;
    height: 36px;
    background-color: #D0D5DD;
    border-radius: 6px;
    margin-right: 8px;
}

.card-info {
    flex-direction: column;
    margin-bottom: 12px;
}

.card-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: #101828;
    margin-bottom: 2px;
}

.card-desc {
    font-size: 12px;
    color: #667085;
}

.card-open-btn {
    height: 36px;
    background-color: #4F46E5;
    color: #FFFFFF;
    -unity-font-style: bold;
    font-size: 13px;
    border-radius: 8px;
    border-width: 0;
    cursor: link;
}

.card-open-btn:hover {
    background-color: #4338CA;
}

.inspector-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(15, 23, 42, 0.96);
    flex-direction: column;
    z-index: 100;
}

.inspector-overlay.hidden {
    display: none;
}

.inspector-top-bar {
    height: 54px;
    background-color: #1E293B;
    border-bottom-width: 1px;
    border-bottom-color: #334155;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 20px;
    padding-right: 20px;
}

.inspector-title-container {
    flex-direction: row;
    align-items: center;
}

.inspector-badge {
    background-color: #6366F1;
    color: #FFFFFF;
    font-size: 11px;
    -unity-font-style: bold;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-radius: 4px;
    margin-right: 12px;
}

.inspector-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #F8FAFC;
}

.inspector-close-btn {
    height: 36px;
    background-color: #334155;
    color: #F8FAFC;
    -unity-font-style: bold;
    font-size: 13px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 6px;
    border-width: 0;
}

.inspector-close-btn:hover {
    background-color: #475569;
}

.inspector-content-viewport {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
}
