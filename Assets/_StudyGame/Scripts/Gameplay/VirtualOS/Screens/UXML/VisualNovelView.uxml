<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:views="StudyGame.UI.Views">
    <ui:Style src="VisualNovelView.uss" />

    <views:VisualNovelView class="vn-root">
        <!-- Overlays (Scanlines, Vignette) -->
        <ui:VisualElement name="Layer_Scanlines" class="vn-overlay vn-scanlines" picking-mode="Ignore" />
        <ui:VisualElement name="Layer_Vignette" class="vn-overlay vn-vignette vn-vignette--hidden" picking-mode="Ignore" />

        <!-- Background Scene Layout -->
        <ui:VisualElement name="Bg_Container" class="vn-bg-container" picking-mode="Ignore">
            <!-- C#에서 하프톤 텍스처가 주입될 영역 -->
            <ui:VisualElement name="Bg_Teal" class="vn-bg-teal">
                <ui:VisualElement class="vn-teal-accent-left" />
                <ui:VisualElement class="vn-teal-accent-right" />
                
                <!-- Character Placeholder -->
                <ui:VisualElement name="Character_Silhouette" class="vn-character-silhouette" />
            </ui:VisualElement>
            
            <ui:VisualElement name="Bg_Magenta" class="vn-bg-magenta">
                <ui:VisualElement class="vn-magenta-slash-1" />
                <ui:VisualElement class="vn-magenta-slash-2" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Top-Left Projection Badge -->
        <ui:VisualElement class="vn-header-left">
            <ui:VisualElement name="Badge_Projection" class="vn-projection-badge">
                <ui:VisualElement class="vn-diamond vn-diamond--badge">
                    <ui:Label text="映" class="vn-badge-text" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="vn-mode-indicator">
                <ui:Label text="PROJECTION RECALL" class="vn-mode-title" />
                <ui:Label text="SCENE: MEMORY_0992" class="vn-mode-sub" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Top-Right Quick Bar -->
        <ui:VisualElement class="vn-header-right">
            <ui:Button name="Btn_Auto" text="AUTO" class="vn-nav-btn" />
            <ui:Button name="Btn_Skip" text="SKIP" class="vn-nav-btn" />
            <ui:Button name="Btn_Log" text="LOG" class="vn-nav-btn" />
            <ui:Button name="Btn_Sound" text="SND" class="vn-nav-btn" />
        </ui:VisualElement>

        <!-- Interactive Main Dialogue Area -->
        <ui:VisualElement name="Zone_Clickable" class="vn-click-zone">
            
            <!-- Name Plate -->
            <ui:VisualElement class="vn-nameplate-wrapper">
                <ui:VisualElement class="vn-nameplate">
                    <ui:Label name="Lbl_CharacterName" text="セ・セ・ナ" class="vn-name-text" />
                    <ui:VisualElement class="vn-gems-container">
                        <ui:VisualElement name="Gem_Amber" class="vn-diamond vn-gem vn-gem--amber" />
                        <ui:VisualElement name="Gem_Cyan" class="vn-diamond vn-gem vn-gem--cyan" />
                        <ui:VisualElement name="Gem_Emerald" class="vn-diamond vn-gem vn-gem--emerald" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Dialogue Frame Window -->
            <ui:VisualElement name="Frame_Dialogue" class="vn-dialogue-frame">
                <!-- Stained Glass Corners (Placeholder for Sprites) -->
                <ui:VisualElement name="Decor_Left" class="vn-decor-glass vn-decor-glass--left" />
                <ui:VisualElement name="Decor_Right" class="vn-decor-glass vn-decor-glass--right" />
                
                <ui:VisualElement class="vn-dialogue-content">
                    <ui:Label name="Lbl_DialogueText" text="..." class="vn-dialogue-text" />
                </ui:VisualElement>

                <!-- Next Sigil Marker -->
                <ui:VisualElement name="Marker_Sigil" class="vn-sigil-container">
                    <ui:VisualElement class="vn-diamond vn-sigil-outer">
                        <ui:VisualElement class="vn-sigil-inner" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- Backlog / History Modal Overlay -->
        <ui:VisualElement name="Modal_Backlog" class="vn-modal vn-modal--hidden">
            <ui:VisualElement class="vn-modal-header">
                <ui:Label text="CHRONICLE LOG" class="vn-modal-title" />
                <ui:Button name="Btn_CloseLog" text="CLOSE [ESC]" class="vn-nav-btn" />
            </ui:VisualElement>
            <ui:ScrollView name="Scroll_Log" class="vn-modal-scroll" />
        </ui:VisualElement>

        <!-- Toast -->
        <ui:VisualElement name="Toast_Message" class="vn-toast vn-toast--hidden">
            <ui:VisualElement class="vn-toast-dot" />
            <ui:Label name="Lbl_ToastText" text="NOTIFICATION" class="vn-toast-text" />
        </ui:VisualElement>

    </views:VisualNovelView>
</ui:UXML>