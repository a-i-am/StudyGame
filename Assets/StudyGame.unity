--- !u!114 &1992561652
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1992561648}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 21467b9a026eb0742b02855e7fcd7f83, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  mockPassages:
  - passageId: P_001
    contentText: "\uB8E8\uBBF8\uB098 \uACF5\uBA85\uC740 \uC2E0\uAE30\uD55C \uD604\uC0C1\uC774\uB2E4.
      \uC544\uC774\uACE0... \uC815\uB9D0 \uB180\uB78D\uC9C0 \uC54A\uC740\uAC00? \uB9E4\uC9C8\uC758
      \uC810\uC131\uC774 \uC9C0\uB098\uCE58\uAC8C \uB192\uC73C\uBA74\xB7\xB7\xB7
      \uACF5\uBA85 \uD604\uC0C1 \uC790\uCCB4\uAC00 \uC5B5\uC81C\uB41C\uB2E4."
    correctKeyword: 
    sentenceScores: 140000001e00000032000000
  - passageId: P_002
    contentText: "1994\uB144 \uC5B4\uB290 \uB0A0\uC774\uC5C8\uB2E4. \uADF8\uB294
      \uB9D0\uD588\uB2E4. '\uC774\uAC83\uC740 \uC5C4\uCCAD\uB09C \uBC1C\uACAC\uC774\uB2E4!'"
    correctKeyword: 
    sentenceScores: 
  - passageId: P_003
    contentText: "\uC218\uD5D8\uD45C\uB97C \uBCF4\uC5EC\uC8FC\uC2DC\uACA0\uC5B4\uC694?
      ...\uC544, \uC218\uD5D8\uD45C\uAC00 \uC5C6\uC73C\uC2DC\uAD70\uC694. \uB3CC\uC544\uAC00\uC138\uC694."
    correctKeyword: 
    sentenceScores: 
  - passageId: P_004
    contentText: "\uB8E8\uBBF8\uB098 \uACF5\uBA85(Lumina Resonance)\uC740 \uD2B9\uC815
      \uC8FC\uD30C\uC218\uC758 \uC74C\uD30C\uAC00 \uD22C\uBA85\uD55C \uC561\uCCB4
      \uB9E4\uC9C8\uC744 \uD1B5\uACFC\uD560 \uB54C, \uC561\uCCB4 \uB0B4\uBD80\uC758
      \uBBF8\uC138 \uAE30\uD3EC\uAC00 \uBE5B\uC744 \uBC1C\uC0B0\uD558\uB294 \uD604\uC0C1\uC774\uB2E4.
      \uC774 \uD604\uC0C1\uC740 \uAE30\uD3EC\uAC00 \uC74C\uD30C\uC758 \uC555\uB825
      \uBCC0\uD654\uC5D0 \uB530\uB77C \uC218\uCD95\uACFC \uD33D\uCC3D\uC744 \uBC18\uBCF5\uD558\uB2E4\uAC00
      \uC784\uACC4\uC810\uC5D0 \uB3C4\uB2EC\uD574 \uAE09\uACA9\uD788 \uBD95\uAD34\uD560
      \uB54C \uBC1C\uC0DD\uD55C\uB2E4. \uC774\uB54C \uAE30\uD3EC \uB0B4\uBD80\uC5D0
      \uC751\uCD95\uB418\uC5C8\uB358 \uC5C4\uCCAD\uB09C \uC5D0\uB108\uC9C0\uAC00
      \uC21C\uAC04\uC801\uC73C\uB85C \uBE5B \uC5D0\uB108\uC9C0\uB85C \uC804\uD658\uB418\uB294
      \uAC83\uC774\uB2E4. \uB8E8\uBBF8\uB098 \uACF5\uBA85\uC758 \uAC15\uB3C4\uB294
      \uC561\uCCB4\uC758 \uC628\uB3C4\uC640 \uBC00\uC811\uD55C \uAD00\uB828\uC774
      \uC788\uB2E4. \uC628\uB3C4\uAC00 \uB0AE\uC744\uC218\uB85D \uAE30\uD3EC \uB0B4\uBD80\uC758
      \uAE30\uCCB4\uAC00 \uC548\uC815\uD654\uB418\uACE0 \uC99D\uAE30\uC555\uC774
      \uB0AE\uC544\uC838 \uBD95\uAD34 \uC2DC \uB354 \uBC1D\uACE0 \uAC15\uB82C\uD55C
      \uBE5B\uC744 \uB0B8\uB2E4. \uBC18\uBA74, \uB9E4\uC9C8\uC758 \uC810\uC131\uC774
      \uC9C0\uB098\uCE58\uAC8C \uB192\uC73C\uBA74 \uC74C\uD30C\uC758 \uC5D0\uB108\uC9C0\uAC00
      \uB9E4\uC9C8\uC5D0 \uD761\uC218\uB418\uC5B4 \uAE30\uD3EC\uB85C \uC81C\uB300\uB85C
      \uC804\uB2EC\uB418\uC9C0 \uBABB\uD558\uBBC0\uB85C \uACF5\uBA85 \uD604\uC0C1
      \uC790\uCCB4\uAC00 \uC5B5\uC81C\uB41C\uB2E4."
    correctKeyword: 
    sentenceScores: 
  - passageId: P_005
    contentText: "\uB098\uB294 \uACE0\uAC1C\uB3C4 \uB3CC\uB9AC\uC9C0 \uC54A\uACE0
      \uC77C\uD558\uB358 \uC190\uC73C\uB85C \uADF8 \uAC10\uC790\uB97C \uB3C4\uB85C
      \uC5B4\uAE68 \uB108\uBA38\uB85C \uC465 \uBC00\uC5B4 \uBC84\uB838\uB2E4. \uADF8\uB7AC\uB354\uB2C8
      \uADF8\uB798\uB3C4 \uAC00\uB294 \uAE30\uC0C9\uC774 \uC5C6\uACE0, \uBFD0\uB9CC
      \uC544\uB2C8\uB77C \uC314\uADFC\uC314\uADFC\uD558\uACE0 \uC2EC\uC0C1\uCE58
      \uC54A\uAC8C \uC228\uC18C\uB9AC\uAC00 \uC810\uC810 \uAC70\uCE60\uC5B4\uC9C4\uB2E4.
      \uC774\uAC74 \uB610 \uBB50\uC57C \uC2F6\uC5B4\uC11C \uADF8\uB54C\uC5D0\uC57C
      \uBE44\uB85C\uC18C \uB3CC\uC544\uB2E4\uBCF4\uB2C8 \uB098\uB294 \uCC38\uC73C\uB85C
      \uB180\uB790\uB2E4. \uC6B0\uB9AC\uAC00 \uC774 \uB3D9\uB124\uC5D0 \uB4E4\uC5B4\uC628
      \uAC83\uC740 \uADFC \uC0BC\uB144\uC9F8 \uB418\uC5B4\uC624\uC9C0\uB9CC \uC5EC\uD0DC\uAECF
      \uAC00\uBB34\uC7A1\uC7A1\uD55C \uC810\uC21C\uC774\uC758 \uC5BC\uAD74\uC774
      \uC774\uB807\uAC8C\uAE4C\uC9C0 \uD64D\uB2F9\uBB34\uCC98\uB7FC \uC0C8\uBE68\uAC1C\uC9C4
      \uBC95\uC774 \uC5C6\uC5C8\uB2E4. \uAC8C\uB2E4 \uB208\uC5D0 \uB3C5\uC744 \uC62C\uB9AC\uACE0
      \uD55C\uCC38 \uB098\uB97C \uC694\uB807\uAC8C \uC3D8\uC544\uBCF4\uB354\uB2C8
      \uB098\uC911\uC5D0\uB294 \uB208\uBB3C\uAE4C\uC9C0 \uC5B4\uB9AC\uB294 \uAC83\uC774
      \uC544\uB2C8\uB0D0. \uADF8\uB9AC\uACE0 \uBC14\uAD6C\uB2C8\uB97C \uB2E4\uC2DC
      \uC9D1\uC5B4\uB4E4\uB354\uB2C8 \uC774\uB97C \uAF2D \uC545\uBB3C\uACE0\uB294
      \uC5CE\uC5B4\uC9C8 \uB4EF \uC790\uBE60\uC9C8 \uB4EF \uB17C\uB451\uC73C\uB85C
      \uD6A1\uD558\uAC8C \uB2EC\uC544\uB098\uB294 \uAC83\uC774\uB2E4."
    correctKeyword: 
    sentenceScores: 140000001e00000032000000
  testIndex: 4
  passageText: {fileID: 1992561650}
  scoreText: {fileID: 1815377760}
  currentHighlightMode: 1
